pub view @ui.sample.confirmation ConfirmationDialog(message: String) {
    Column(spacing = 20) {
        Text(message)
            .style {
                font-size = milli(18000)
            }
        Row(spacing = 12) {
            Button(@button:.cancel)
                .label("Cancel")
                .agent_target(@ui.sample.confirmation.cancel)
                .style {
                    background-color = rgba(72, 80, 94, 255)
                    focus-ring-width = milli(3000)
                }
                .on_click(|| action.invoke(@action.confirmation.cancel))
            Button(@button:.accept)
                .label("Accept")
                .agent_target(@ui.sample.confirmation.accept)
                .style {
                    background-color = rgba(54, 190, 170, 255)
                    focus-ring-width = milli(3000)
                }
                .on_click(|| action.invoke(@action.confirmation.accept))
        }
    }
}
