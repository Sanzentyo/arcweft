pub view @ui.sample.toolbar ActionToolbar(actions: Vec<ToolbarAction>) {
    Row(spacing = 10) {
        for action_item in actions key = action_item.id {
            Button(@button:.toolbar_item)
                .label(action_item.label)
                .agent_target(@ui.sample.toolbar.item)
                .enabled(action_item.enabled)
                .style {
                    background-color = rgba(44, 58, 78, 255)
                    focus-ring-width = milli(2000)
                }
                .on_click(|| action.invoke(@action.toolbar.invoke, payload = action_item.id))
        }
    }
}
