{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/arcweft/web-observation-v2.schema.json",
  "title": "Arcweft Web Player Diagnostic Observation",
  "description": "Debug and test observation only. This is not a DOM or renderer command protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "step_index",
    "logical_tick",
    "logical_dt_millis",
    "stop_reason",
    "status",
    "finished",
    "diagnostics",
    "presentation_revision",
    "dialogue_present",
    "choice_count",
    "flow_event_count",
    "requested_tasks",
    "queued_task_events"
  ],
  "properties": {
    "schema_version": { "const": "arcweft.web_observation.v2" },
    "step_index": { "type": "integer", "minimum": 0 },
    "logical_tick": { "type": "integer", "minimum": 1 },
    "logical_dt_millis": { "type": "integer", "minimum": 1 },
    "stop_reason": { "type": "string" },
    "status": { "type": "string" },
    "finished": { "type": "boolean" },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "presentation_revision": { "type": "integer", "minimum": 0 },
    "dialogue_present": { "type": "boolean" },
    "choice_count": { "type": "integer", "minimum": 0 },
    "flow_event_count": { "type": "integer", "minimum": 0 },
    "requested_tasks": { "type": "integer", "minimum": 0 },
    "queued_task_events": { "type": "integer", "minimum": 0 }
  }
}
