pub character zunda_guide {
    display = "ずんだガイド"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Yu Gothic"
                color = rgb("#aee28e")
                size = 26px
            }
        }
    }
}

pub character narrator {
    display = "語り手"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Yu Mincho"
                color = rgb("#f1dbc8")
                size = 23px
            }
        }
    }
}

pub style web_panel {
    .web_panel {
        background-color = rgba(17, 18, 16, 242)
    }
    .web_speaker {
        font-family = ["Yu Gothic UI"]
        color = rgba(174, 226, 142, 255)
        font-size = 18px
        line-height = 28px
        font-weight = 700
    }
    .web_content {
        font-family = ["Yu Gothic UI"]
        color = rgba(247, 244, 232, 255)
        font-size = 24px
        line-height = 34px
    }
    .web_action {
        background-color = rgba(0, 0, 0, 0)
    }
}

pub view WebPanel(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
            .part(web_speaker)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .part(web_content)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(web_action)
            .on_click { dialogue.primary_action }
    }
        .part(web_panel)
        .style(@style.web_panel)
}

pub dialogue defaults {
    view = @view.WebPanel
}

pub asset generated.background {
    kind = image
    file = "generated/background.png"
}

pub asset generated.character_stand {
    kind = image
    file = "generated/character_stand.png"
}

pub asset generated.gif_pulse {
    kind = image
    file = "generated/gif_pulse.gif"
}

pub asset generated.webp_pulse {
    kind = image
    file = "generated/webp_pulse.webp"
}

pub image @image.generated.character_stand {
    asset = @asset:.generated.character_stand
    x = 72px
    y = 52px
    width = 208px
    height = 332px
}

pub image @image.generated.background {
    asset = @asset:.generated.background
    x = 0px
    y = 0px
    width = 1280px
    height = 720px
}

pub image @image.generated.gif_pulse {
    asset = @asset:.generated.gif_pulse
    x = 486px
    y = 46px
    width = 96px
    height = 96px
}

pub image @image.generated.webp_pulse {
    asset = @asset:.generated.webp_pulse
    x = 492px
    y = 156px
    width = 96px
    height = 96px
}

entry game @entry.main { goto @flow.main }

flow main {
    image(@image.generated.background)
    image(@image.generated.character_stand)
    image(@image.generated.gif_pulse)
    image(@image.generated.webp_pulse)

    narrator(id=@say.web_demo.narrator, voice=auto):
        語り手は明朝体と薄い桃色で表示される。既定のタイプライター表示で、WASMでもnativeでも同じ速度で文字が現れる。[p]これは同じdialogue lineの2ページ目で、次の入力までは次のlineへ進まない。

    zunda_guide(id=@say.web_demo.guide, voice=auto, look=.normal):
        こちらはキャラクターsurfaceの色とフォントを使う行なのだ。[.wave amp=4px freq=8]波打つ文字[/]と、右上のアニメーション画像も同じフレーム計画で動いているのだ。

    choice @choice.web_demo {
        @choice.web_demo.continue "このまま進む" -> @flow.done
        @choice.web_demo.alternate "別ルートを見る" -> @flow.done
    }
}

flow done {
    zunda_guide(id=@say.web_demo.done, voice=auto, look=.smile):
        choiceの当たり判定と見た目が一致したのだ。スクロールしてもボタンの場所は上下しないのだ。
    return "done"
}
