{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcweft.dev/schemas/compositing-capture-evidence.schema.json",
  "title": "Arcweft compositing capture evidence",
  "type": "object",
  "required": ["schema_version", "objects", "groups"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "arcweft.compositing-capture.v1" },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/object_record" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group_record" }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "primitive_range": {
      "type": ["object", "null"],
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["node", "key", "kind", "style", "component", "program", "part", "semantic", "handlers", "agent"],
      "additionalProperties": false,
      "properties": {
        "node": { "type": "integer", "minimum": 0 },
        "key": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string" },
        "style": { "type": "integer", "minimum": 0 },
        "component": { "type": ["integer", "null"], "minimum": 0 },
        "program": { "type": ["integer", "null"], "minimum": 0 },
        "part": { "type": ["integer", "null"], "minimum": 0 },
        "semantic": { "type": ["integer", "null"], "minimum": 0 },
        "handlers": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "agent": { "type": ["string", "null"] }
      }
    },
    "effect_outsets": {
      "type": "object",
      "required": ["filter_px", "backdrop_filter_px", "mask_px", "total_px"],
      "additionalProperties": false,
      "properties": {
        "filter_px": { "type": "number", "minimum": 0 },
        "backdrop_filter_px": { "type": "number", "minimum": 0 },
        "mask_px": { "type": "number", "minimum": 0 },
        "total_px": { "type": "number", "minimum": 0 }
      }
    },
    "common_record": {
      "type": "object",
      "required": ["record_kind", "paint_node_id", "compositing_group_id", "primitive_range", "metadata", "layout_bounds", "visual_bounds", "hit_bounds", "clip_bounds", "mask_bounds", "effect_outsets"],
      "properties": {
        "record_kind": { "type": "string" },
        "paint_node_id": { "type": ["integer", "null"], "minimum": 0 },
        "compositing_group_id": { "type": ["integer", "null"], "minimum": 0 },
        "primitive_range": { "$ref": "#/$defs/primitive_range" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "layout_bounds": { "$ref": "#/$defs/rect" },
        "primitive_bounds": { "$ref": "#/$defs/rect" },
        "visual_bounds": { "$ref": "#/$defs/rect" },
        "hit_bounds": { "$ref": "#/$defs/rect" },
        "clip_bounds": { "anyOf": [{ "$ref": "#/$defs/rect" }, { "type": "null" }] },
        "mask_bounds": { "type": "array", "items": { "$ref": "#/$defs/rect" } },
        "effect_outsets": { "$ref": "#/$defs/effect_outsets" }
      }
    },
    "object_record": {
      "allOf": [
        { "$ref": "#/$defs/common_record" },
        { "type": "object", "properties": { "record_kind": { "const": "object" } } }
      ]
    },
    "group_record": {
      "allOf": [
        { "$ref": "#/$defs/common_record" },
        {
          "type": "object",
          "required": ["isolation", "blend_mode"],
          "properties": {
            "record_kind": { "const": "compositing_group" },
            "isolation": { "type": "string" },
            "blend_mode": { "type": "string" }
          }
        }
      ]
    }
  }
}
