{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcweft.invalid/schema/character-awchar-v1.json",
  "title": "Arcweft Character Manifest",
  "description": "Version 1 typed standing-character composition manifest used inside an .awchar package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "character",
    "canvas",
    "anchor",
    "default_look",
    "parts",
    "looks"
  ],
  "properties": {
    "format": { "const": "arcweft.character" },
    "version": { "const": 1 },
    "character": { "$ref": "#/$defs/characterId" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "anchor": { "$ref": "#/$defs/point" },
    "default_look": { "$ref": "#/$defs/localId" },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/part" }
    },
    "looks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/look" }
    },
    "source": { "$ref": "#/$defs/source" }
  },
  "$defs": {
    "characterId": {
      "type": "string",
      "pattern": "^character\\.[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "assetPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?:[^/\\\\]+/)*[^/\\\\]+\\.png$"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "y": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "y": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "width": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "blend": {
      "type": "string",
      "enum": [
        "pass_through",
        "normal",
        "dissolve",
        "darken",
        "multiply",
        "color_burn",
        "linear_burn",
        "darker_color",
        "lighten",
        "screen",
        "color_dodge",
        "linear_dodge",
        "lighter_color",
        "overlay",
        "soft_light",
        "hard_light",
        "vivid_light",
        "linear_light",
        "pin_light",
        "hard_mix",
        "difference",
        "exclusion",
        "subtract",
        "divide",
        "hue",
        "saturation",
        "color",
        "luminosity"
      ]
    },
    "sourceLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "group", "layer"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "group": { "type": "string" },
        "layer": { "type": "string" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset", "rect", "opacity", "blend", "clipping"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "asset": { "$ref": "#/$defs/assetPath" },
        "rect": { "$ref": "#/$defs/rect" },
        "opacity": { "type": "integer", "minimum": 0, "maximum": 255 },
        "blend": { "$ref": "#/$defs/blend" },
        "clipping": { "type": "boolean" },
        "source_layer": { "$ref": "#/$defs/sourceLayer" }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "z", "variants"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "z": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "variant"],
      "properties": {
        "part": { "$ref": "#/$defs/localId" },
        "variant": { "$ref": "#/$defs/localId" }
      }
    },
    "look": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "select"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "select": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/selection" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file_name", "blake3", "importer"],
      "properties": {
        "kind": { "const": "psd" },
        "file_name": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "blake3": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "importer": { "type": "string", "minLength": 1 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
