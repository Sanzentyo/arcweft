pub style inset_shadow_exact {
    .rounded_inset_shadow_card {
        width = 112px
        height = 72px
        border-radius = 14px
        background-color = rgba(36, 42, 54, 255)
        box-shadow = [
            inset_shadow(
                x = 0px,
                y = 3px,
                blur = 12px,
                spread = 2px,
                color = rgba(0, 0, 0, 143),
            ),
        ]
    }

    .mixed_outer_inset_shadow_card {
        width = 112px
        height = 72px
        border-radius = 16px
        background-color = rgba(255, 255, 255, 255)
        box-shadow = [
            shadow(
                x = 0px,
                y = 10px,
                blur = 18px,
                spread = 2px,
                color = rgba(0, 0, 0, 97),
            ),
            inset_shadow(
                x = 0px,
                y = -2px,
                blur = 10px,
                spread = 1px,
                color = rgba(255, 255, 255, 89),
            ),
        ]
    }
}
