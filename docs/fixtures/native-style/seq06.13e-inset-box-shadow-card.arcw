pub style inset_shadow_exact {
    .rounded_inset_shadow_card {
        width = 112px
        height = 72px
        border-radius = 14px
        background-color = rgba(36, 42, 54, 255)
        box-shadow = [
            inset_shadow(
                x = 0px,
                y = 3px,
                blur = 12px,
                spread = 2px,
                color = rgba(0, 0, 0, 143),
            ),
        ]
    }

    .mixed_outer_inset_shadow_card {
        width = 112px
        height = 72px
        border-radius = 16px
        background-color = rgba(255, 255, 255, 255)
        box-shadow = [
            shadow(
                x = 0px,
                y = 10px,
                blur = 18px,
                spread = 2px,
                color = rgba(0, 0, 0, 97),
            ),
            inset_shadow(
                x = 0px,
                y = -2px,
                blur = 10px,
                spread = 1px,
                color = rgba(255, 255, 255, 89),
            ),
        ]
    }
}

pub view ShadowCards() {
    Stack(width = 320px, height = 180px) {
        Panel(x = 24px, y = 24px, part = rounded_inset_shadow_card)
        Panel(x = 176px, y = 40px, part = mixed_outer_inset_shadow_card)
    }.style(@style.inset_shadow_exact)
}
flow main() -> String {
    let cards = mount(ShadowCards());
    wait(1s)
    return "done"
}
entry cli @entry.main { goto @flow.main }