+            .as_ref()
+            .unwrap()
+            .retirements()
+            .is_empty()
+    );
+    executor.snapshot().unwrap();
+    step(&mut executor);
+    assert_eq!(executor.fiber.status, FiberStatus::Returned);
+    assert_eq!(
+        executor.presentation.as_ref().unwrap().retirements()[0].token,
+        tokens[1]
+    );
+    executor.snapshot().unwrap();
+}
