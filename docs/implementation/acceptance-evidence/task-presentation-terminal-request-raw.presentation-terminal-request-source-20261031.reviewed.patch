+fn control_fixture(
+    kind: AwbcEffectKind,
+    blocked: bool,
+) -> (AwbcProductStepExecutor, Vec<RuntimePresentationHandleToken>) {
+    let mut program = super::traps::nested_program();
+    let effect = push_effect_plan(&mut program, kind);
+    program.instructions.push(AwbcInstruction::EmitEffect {
+        effect,
+        args: vec![],
+    });
