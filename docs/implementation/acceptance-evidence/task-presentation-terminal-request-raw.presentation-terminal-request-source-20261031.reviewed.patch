+                    self.program.resolve_flow_target_value(&target).is_err()
+                }
+                Some(ProductControlEffect::Return(_)) | None => false,
+            }
+        });
+        if trap {
+            self.program.preflight_fiber_unwinds(
+                self.presentation.as_ref(),
+                std::iter::once(&self.fiber),
+            )?;
+        }
+        Ok(())
+    }
