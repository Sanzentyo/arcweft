+                    .presentation
+                    .as_mut()
+                    .unwrap()
+                    .retirements_mut()
+                    .clear();
+            }
+            selected_step(&mut executor, &mut input, &mut Vec::new());
+            assert!(input.host_call_results.is_empty());
+            assert_eq!(
+                executor.presentation.as_ref().unwrap().retirements()[0].token,
+                token
+            );
+            executor.snapshot().unwrap();
+            if !blocked {
+                roundtrip(executor);
+            }
+        }
+    }
+}
