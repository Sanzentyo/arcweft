+fn issue_test_dialogue(
+    executor: &mut AwbcProductStepExecutor,
+    content: AwbcContentUnitId,
+) -> crate::runtime_id::DialogueActivationId {
+    let (activation, key, next) = executor.prepare_dialogue_activation(content).unwrap();
