// Seq-03.7 wrong-base source fixture.
// This bundle is only used as the base of a patch that is then offered to a
// running player whose active base is base.arcw. The typed path must reject it
// and leave the old session/catalog active.
flow main {
    line @line.opening alice "Windowed smoke: wrong base"
    choice @choice.opening {
        option @choice.opening.next "Next" -> @flow.done
    }
}

flow done {
    return "done"
}

image_asset @sprite file "asset/sprite.png" format png size 1 1
image_object @sprite.object asset @sprite bounds 0 0 1000 1000 fit stretch
