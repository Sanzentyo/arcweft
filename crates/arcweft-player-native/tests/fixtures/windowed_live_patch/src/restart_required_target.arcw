// Seq-03.7 restart-required target fixture.
// The sprite object and virtual image payload are intentionally absent. The
// generated patch removes required bundle sections, which classifies as
// restart-required and forces the native endpoint restart path.
flow main {
    line @line.opening alice "Windowed smoke: restart target"
    choice @choice.opening {
        option @choice.opening.next "Next" -> @flow.done
    }
}

flow done {
    return "done"
}
