// Seq-03.7 content-only target fixture.
// Changes presentation text and the sprite bytes while keeping the executable
// flow graph unchanged. This should classify as content-only.
flow main {
    line @line.opening alice "Windowed smoke: content target"
    choice @choice.opening {
        option @choice.opening.next "Next" -> @flow.done
    }
}

flow done {
    return "done"
}

image_asset @sprite file "asset/sprite.png" format png size 1 1
image_object @sprite.object asset @sprite bounds 0 0 1000 1000 fit stretch
