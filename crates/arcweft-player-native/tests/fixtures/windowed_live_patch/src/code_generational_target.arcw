// Seq-03.7 code-generational target fixture.
// The default foreground flow executable changes from dialogue+choice to a
// return-only body. Existing foreground fibers remain on the old generation;
// newly started foreground entries bind to this target generation.
flow main {
    return "changed"
}

flow done {
    return "done"
}

image_asset @sprite file "asset/sprite.png" format png size 1 1
image_object @sprite.object asset @sprite bounds 0 0 1000 1000 fit stretch
