mod verify::oxiz_z3_parity::UFLRA::real_unsat;

/// One-to-one Arcweft migration of `bench/z3_parity/benchmarks/UFLRA/real_unsat.smt2`.
/// Expected Z3 result: `unsat`.
proof @oxiz_z3_parity.UFLRA.real_unsat {
    source_repo = "cool-japan/oxiz";
    source_commit = "9f6bb93df338fd8e965511e9e1abc97ed3ca395f";
    source_path = "bench/z3_parity/benchmarks/UFLRA/real_unsat.smt2";
    expected = "unsat";
    emit_smt <<SMT
; Arcweft migration fixture for UFLRA.real_unsat
; Source: cool-japan/oxiz:bench/z3_parity/benchmarks/UFLRA/real_unsat.smt2@9f6bb93df338fd8e965511e9e1abc97ed3ca395f
; Expected: unsat
; Equivalence scope: normalized logic/satisfiability fixture for Arcweft SMT emission tests.

(set-logic UFLRA)
(declare-fun real_unsat_f (Real) Real)
(assert (forall ((x Real)) (= (real_unsat_f x) (real_unsat_f x))))
(declare-const real_unsat_c Real)
(assert (not (= (real_unsat_f real_unsat_c) (real_unsat_f real_unsat_c))))
(check-sat)
SMT
}
