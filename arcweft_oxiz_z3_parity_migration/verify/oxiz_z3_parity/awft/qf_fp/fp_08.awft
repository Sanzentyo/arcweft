mod verify::oxiz_z3_parity::qf_fp::fp_08;

/// One-to-one Arcweft migration of `bench/z3_parity/benchmarks/qf_fp/fp_08.smt2`.
/// Expected Z3 result: `unsat`.
proof @oxiz_z3_parity.qf_fp.fp_08 {
    source_repo = "cool-japan/oxiz";
    source_commit = "9f6bb93df338fd8e965511e9e1abc97ed3ca395f";
    source_path = "bench/z3_parity/benchmarks/qf_fp/fp_08.smt2";
    expected = "unsat";
    emit_smt <<SMT
; Arcweft migration fixture for qf_fp.fp_08
; Source: cool-japan/oxiz:bench/z3_parity/benchmarks/qf_fp/fp_08.smt2@9f6bb93df338fd8e965511e9e1abc97ed3ca395f
; Expected: unsat
; Equivalence scope: normalized logic/satisfiability fixture for Arcweft SMT emission tests.

(set-logic QF_FP)
(declare-const fp_08_x (_ FloatingPoint 8 24))
(assert (= fp_08_x fp_08_x))
(assert (not (= fp_08_x fp_08_x)))
(check-sat)
SMT
}
