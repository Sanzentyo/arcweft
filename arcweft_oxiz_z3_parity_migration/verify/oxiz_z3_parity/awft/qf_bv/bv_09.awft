proof @oxiz_z3_parity.qf_bv.bv_09 {
    source_repo = "cool-japan/oxiz";
    source_commit = "9f6bb93df338fd8e965511e9e1abc97ed3ca395f";
    source_path = "bench/z3_parity/benchmarks/qf_bv/bv_09.smt2";
    expected = "sat";
    emit_smt <<SMT
; Arcweft migration fixture for qf_bv.bv_09
; Source: cool-japan/oxiz:bench/z3_parity/benchmarks/qf_bv/bv_09.smt2@9f6bb93df338fd8e965511e9e1abc97ed3ca395f
; Expected: sat
; Equivalence scope: normalized logic/satisfiability fixture for Arcweft SMT emission tests.

(set-logic QF_BV)
(declare-const bv_09_x (_ BitVec 8))
(assert (= (bvand bv_09_x #xff) bv_09_x))
(check-sat)
SMT
}
