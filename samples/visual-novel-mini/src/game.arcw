pub surface character @character.alice Alice as alice {
    default_voice = auto
}

pub surface character @character.narrator Narrator as narrator {
    default_voice = auto
}

signal @signal:.current_flow: Watch<Ref<Flow>>
metric gauge @metric:.opening_lines: i32

entry game @entry.main {
    start @flow.opening
}

flow @flow.opening opening
effects { signal.write, metric.write }
{
    log.info("enter opening")
    signal.set(@signal.current_flow, @flow.opening)
    metric.set(@metric.opening_lines, 1)

    narrator.say(id=@say.opening.narrator.001, voice=auto)[
        雨の音だけが、古い駅舎に残っていた。[p]
    ]

    let alice2 = alice(face=.smile, voice=auto, window=@textbox:.side)
    alice2:
        おはよう。[p]

    let route = if player_score() >= 3 {
        @flow.alice_intro
    } else {
        @flow.quiet_intro
    }

    alice.say(id=@say.opening.alice.001, voice=auto, look=.smile)[
        今日は少しだけ、｜変な夢《へんなゆめ》を見たんだ。[p]
    ]
    with:
        let voice = line.voice_handle()
        at(0.42s):
            alice.face(.worried)
        out voice

    choice @choice.opening.first {
        @.listen "聞いてみる" -> @flow.alice_intro
        @.silent "黙っている" -> @flow.quiet_intro
    }

    goto route
}

flow @flow.alice_intro alice_intro
effects { signal.write }
{
    log.info("route alice_intro")
    signal.set(@signal.current_flow, @flow.alice_intro)

    alice:
        夢の中でも、あなたは同じ場所にいたよ。[p]

    return "alice_intro"
}

flow @flow.quiet_intro quiet_intro
effects { signal.write }
{
    log.info("route quiet_intro")
    signal.set(@signal.current_flow, @flow.quiet_intro)

    narrator:
        アリスは少し笑って、それ以上は聞かなかった。[p]

    return "quiet_intro"
}

flow @flow.title title {
    return "title"
}

fn player_score() -> i32 {
    4
}
