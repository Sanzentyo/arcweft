pub character alice {
    display = "Alice"
    default_voice = auto
}

pub character narrator {
    display = "Narrator"
    default_voice = auto
}

pub style side_dialogue {
    .dialogue_panel {
        background-color = rgba(17, 18, 16, 242)
    }
    .dialogue_action {
        background-color = rgba(0, 0, 0, 0)
    }
}

pub view SideDialogue(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px, part = dialogue_panel) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
}

signal current_flow: Watch<Ref<Flow>>
metric gauge opening_lines: i32

struct GameState {
    started: bool
}

enum GameEvent {
    Start
}

fn initial_game_state() -> GameState
effects {}
{
    GameState { started = false }
}

fn reduce_game(state: &GameState, event: GameEvent)
    -> Result<Reduction<GameState>, ReducerError>
effects {}
{
    Ok(Reduction.unchanged(state))
}

entry game @entry.main {
    state = GameState
    initializer = initial_game_state
    event = GameEvent
    reducer = reduce_game
    goto @flow.opening
}

flow opening(state: GameState)
effects { signal.write, metric.write }
{
    log.info("enter opening")
    signal.set(@signal.current_flow, @flow.opening)
    metric.set(@metric.opening_lines, 1i32)

    narrator.say(id=@say.opening.narrator.001, voice=auto)[
        雨の音だけが、古い駅舎に残っていた。[p]
    ]

    let alice2 = alice(face=.smile, voice=auto, view=@view.SideDialogue)
    alice2:
        おはよう。[p]

    let route = if player_score() >= 3i32 {
        @flow.alice_intro
    } else {
        @flow.quiet_intro
    }

    alice.say(id=@say.opening.alice.001, voice=auto, look=.smile)[
        今日は少しだけ、|[変な夢](へんなゆめ)を見たんだ。[p]
    ]
    with:
        let voice = line.voice_handle()
        at(0.42s):
            alice.face(.worried)
        out voice

    choice @choice.opening.first {
        @.listen "聞いてみる" -> @flow.alice_intro
        @.silent "黙っている" -> @flow.quiet_intro
    }

    goto route
}

flow alice_intro
effects { signal.write }
{
    log.info("route alice_intro")
    signal.set(@signal.current_flow, @flow.alice_intro)

    alice:
        夢の中でも、あなたは同じ場所にいたよ。[p]

    return "alice_intro"
}

flow quiet_intro
effects { signal.write }
{
    log.info("route quiet_intro")
    signal.set(@signal.current_flow, @flow.quiet_intro)

    narrator:
        アリスは少し笑って、それ以上は聞かなかった。[p]

    return "quiet_intro"
}

flow title {
    return "title"
}

fn player_score() -> i32 {
    4i32
}
