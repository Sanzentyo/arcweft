pub character narrator {
    display = "Narrator"
    default_voice = auto
}

signal current_flow: Watch<Ref<Flow>>

entry game @entry.main {
    goto @flow.opening
}

flow opening effects { signal.write } {
    signal.set(@signal.current_flow, @flow.opening)

    narrator:
        Visual regression textbox.[p]

    narrator:
        Second observed textbox.[p]

    return "opening"
}
