fn project_graph_relations_smoke() -> Result<Unit, AgentError>
effects { debug.read }
{
    let graph = try project_neighbors(@flow.opening, depth = 1u32)

    expect(graph.root == "flow.opening")
    expect(graph.node_count >= 5u32)
    expect(graph.edge_count >= 4u32)

    expect(graph.edges[1].kind == "references_entity")
    expect(graph.edges[2].kind == "flow_include")
    expect(graph.edges[3].kind == "flow_goto")

    return Ok(())
}

entry agent @entry.agent.main {
    controller = project_graph_relations_smoke
}
