fn attach_capture_smoke() -> Result<Unit, AgentError>
effects { agent.capture, debug.record }
{
    let shot = try capture(
        viewport(),
        format = .png,
        kind = .color,
        name = "viewport-attachment",
    )
    attach(shot)
    checkpoint("after-attach-capture")
    return Ok(())
}

entry agent @entry.agent.main {
    controller = attach_capture_smoke
}
