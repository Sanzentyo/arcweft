fn action_fields() -> Result<Unit, AgentError>
effects { agent.observe, debug.record }
{
    let frame = try observe()
    let expected = choice_action(@choice.opening.listen)
    let expected_target = expected.target
    let observed = frame.actions[0]

    checkpoint("action-target-fields-observed")

    observed.target
    Ok(())
}

entry agent @entry.agent.main {
    controller = action_fields
}
