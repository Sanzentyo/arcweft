#[agent(version = 1)]
agent @agent.cli.state_wait state_wait()
effects { agent.observe, agent.wait, debug.read }
{
    let route = state_path("route.phase")
    let tick = observation_path("tick")
    wait(
        all(
            state(route).eq("opening"),
            observation(tick).ge(1i64),
        ),
        timeout = 5s,
        stable_frames = 1u32,
        poll_frames = 1u32,
    )
    return "done"
}
