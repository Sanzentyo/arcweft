
#[budget(timeout = 20s, steps = 96usize, captures = 12usize)]
fn visual_dialogue() -> Result<Unit, AgentError>
effects {
    agent.observe,
    agent.act.semantic,
    agent.wait,
    agent.capture,
    debug.record,
}
{
    try wait(
        signal(@signal.current_flow).eq(@flow.opening),
        timeout = 5s,
    )

    let frame = try observe()
    let dialogue_view = try frame.objects.require_role("dialogue_view")

    let color = try capture(
        object(dialogue_view.id),
        format = .png,
        kind = .color,
        name = "dialogue-view-color",
    )
    let mask = try capture(
        object(dialogue_view.id),
        format = .raw_rgba,
        kind = .mask,
        name = "dialogue-view-mask",
    )

    attach(color)
    attach(mask)
    expect(dialogue_view.bbox.width > 0u32)
    expect(dialogue_view.bbox.height > 0u32)

    Ok(())
}

entry agent @entry.agent.main {
    controller = visual_dialogue
}
