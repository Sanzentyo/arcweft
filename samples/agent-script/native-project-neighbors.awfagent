fn project_neighbors_smoke() -> Result<Unit, AgentError>
effects { debug.read }
{
    let graph = try project_neighbors(@flow.opening, depth = 1u32)

    expect(graph.root == "flow.opening")
    expect(graph.node_count >= 2u32)
    expect(graph.edge_count >= 2u32)

    let root = graph.symbols[0]
    let ownership_edge = graph.edges[0]
    let relation_edge = graph.edges[1]

    expect(root.kind != "")
    expect(ownership_edge.kind == "contains_entity")
    expect(relation_edge.kind == "entry_start")

    return Ok(())
}

entry agent @entry.agent.main {
    controller = project_neighbors_smoke
}
