#[agent(version = 1)]
agent @agent.native.project_neighbors project_neighbors_smoke()
effects { debug.read }
{
    let graph = try project_neighbors(@flow.opening, depth = 1u32)

    expect(graph.root == "flow.opening")
    expect(graph.node_count >= 2u32)
    expect(graph.edge_count >= 1u32)

    let root = graph.symbols[0]
    let edge = graph.edges[0]

    expect(root.kind != "")
    expect(edge.kind == "contains_entity")

    return graph.edge_count
}
