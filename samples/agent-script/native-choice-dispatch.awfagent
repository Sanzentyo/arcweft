#[agent(version = 1)]

agent @agent.native.choice_dispatch native_choice_dispatch()
effects { agent.observe, agent.act.semantic, agent.wait }
{
    observe()

    choose(@choice.opening.listen)

    wait(
        signal(@signal.current_flow).eq(@flow.alice_intro),
        timeout = 5s,
        stable_frames = 1u32,
        poll_frames = 1u32,
    )

    return "done"
}
