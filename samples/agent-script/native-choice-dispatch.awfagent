
fn native_choice_dispatch() -> Result<Unit, AgentError>
effects { agent.observe, agent.act.semantic, agent.wait }
{
    let listen = choice_action(@choice.opening.listen)

    wait(
        action_enabled(listen),
        timeout = 5s,
        stable_frames = 1u32,
        poll_frames = 1u32,
    )

    choose(@choice.opening.listen)

    wait(
        signal(@signal.current_flow).eq(@flow.alice_intro),
        timeout = 5s,
        stable_frames = 1u32,
        poll_frames = 1u32,
    )

    return Ok(())
}

entry agent @entry.agent.main {
    controller = native_choice_dispatch
}
