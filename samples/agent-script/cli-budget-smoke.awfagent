#[budget(
    timeout = 5s,
    steps = 8usize,
    host_calls = 2usize,
    observations = 2usize,
    captures = 0usize,
    rag_queries = 0usize,
    stored_bytes = 0u64,
    context_bytes = 0u64,
)]
fn budget_smoke() -> Result<Unit, AgentError>
effects { agent.observe }
{
    observe()
    return Ok(())
}

entry agent @entry.agent.main {
    controller = budget_smoke
}
