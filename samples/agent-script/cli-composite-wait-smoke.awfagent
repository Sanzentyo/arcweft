fn composite_wait() -> Result<Unit, AgentError>
effects { agent.observe, agent.wait }
{
    wait(
        all(exists(signal(@signal.ready)), not(signal(@signal.ready).eq(false))),
        timeout = 5s,
        stable_frames = 1u32,
        poll_frames = 1u32,
    )
    return Ok(())
}

entry agent @entry.agent.main {
    controller = composite_wait
}
