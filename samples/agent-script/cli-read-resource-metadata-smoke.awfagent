fn read_resource_metadata_smoke() -> Result<Unit, AgentError>
effects { agent.resource.read }
{
    let resource = try read_resource("arcweft://session/cli/observation/latest.json")
    expect(resource.uri == "arcweft://session/cli/observation/latest.json")
    expect(resource.kind == "observation_latest")
    expect(resource.mime_type == "application/json")
    expect(resource.hash == "cli-resource")
    expect(match resource.body {
        .Json(_) => true
        .Text(_) => false
        .BytesBase64(_) => false
    })
    return Ok(())
}

entry agent @entry.agent.main {
    controller = read_resource_metadata_smoke
}
