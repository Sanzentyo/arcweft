pub surface character narrator {
    display = "Narrator"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Yu Gothic UI"
                color = rgb("#f4f8ff")
                size = 30px
            }
        }
    }
}

entry game {
    start @flow.image_static_png
}

flow image_static_png {
    bg(@asset.bg.room)

    narrator.say(id=@say.image.static_png, voice=auto)[
        Static PNG background image as a first-class presentation object.[p]
    ]

    return "image_static_png"
}

flow image_static_jpeg {
    bg(@asset.bg.garden)

    narrator.say(id=@say.image.static_jpeg, voice=auto)[
        Static JPEG background image follows the same Agent capture path.[p]
    ]

    return "image_static_jpeg"
}

flow image_static_webp {
    bg(@asset.bg.poster, fit = "intrinsic", alignment.x = "right", alignment.y = "bottom", opacity = "0.75")

    narrator.say(id=@say.image.static_webp, voice=auto)[
        Static WebP background image is decoded into the same image frame model.[p]
    ]

    return "image_static_webp"
}

flow image_animated_gif {
    bg(@asset.bg.pulse)

    narrator.say(id=@say.image.animated_gif, voice=auto)[
        Animated GIF background image is selected from deterministic capture time.[p]
    ]

    return "image_animated_gif"
}

flow image_animated_webp {
    bg(@asset.bg.loop)

    narrator.say(id=@say.image.animated_webp, voice=auto)[
        Animated WebP background image uses the same deterministic frame selection contract.[p]
    ]

    return "image_animated_webp"
}

flow image_sprite_overlay {
    bg(@asset.bg.room)
    image(asset = @asset.bg.pulse, id = "image.sample.pulse_sprite", target = "target.sample.pulse_sprite", layer = "layer.foreground", x = 96px, y = 72px, width = 360px, height = 180px, fit = "stretch", opacity = "0.5", playback.local_time = 50ms, transform.tx = 24px, transform.ty = 12px, depth = 2500, enabled = true, visible = true, action = "action.inspect.pulse_sprite", param.role = "animated-hotspot", param.hit_channel = "channel.preview", proxy.id = "proxy.pulse_sprite.hotspot", proxy.type = "PulseSpriteHotspot", proxy.role = "inspect", proxy.layer = "layer.hit", proxy.depth = 2600, proxy.hit_test = true, proxy.param.channel = "preview")

    narrator.say(id=@say.image.sprite_overlay, voice=auto)[
        Foreground image object uses authored bounds, layer, object capture, and animation timing.[p]
    ]

    return "image_sprite_overlay"
}

flow image_clipped_object {
    bg(@asset.bg.room)
    image(asset = @asset.bg.pulse, id = "image.sample.clipped_pulse", target = "target.sample.clipped_pulse", layer = "layer.clipped", x = 1184px, y = 48px, width = 192px, height = 96px, fit = "stretch", opacity = "0.5", depth = 2700, enabled = true, visible = true, action = "action.inspect.clipped_pulse", param.role = "clipped-animated-hotspot")

    narrator.say(id=@say.image.clipped_object, voice=auto)[
        Clipped animated image object proves object capture uses viewport-visible geometry.[p]
    ]

    return "image_clipped_object"
}

flow image_alignment_object {
    bg(@asset.bg.room)
    image(asset = @asset.bg.poster, id = "image.sample.aligned_poster", target = "target.sample.aligned_poster", layer = "layer.aligned", x = 96px, y = 72px, width = 360px, height = 180px, fit = "intrinsic", alignment.x = "right", alignment.y = "bottom", opacity = 1, depth = 2400, enabled = true, visible = true, action = "action.inspect.aligned_poster", param.role = "aligned-static-hotspot")

    narrator.say(id=@say.image.alignment_object, voice=auto)[
        Static image object alignment places intrinsic pixels inside authored bounds.[p]
    ]

    return "image_alignment_object"
}
