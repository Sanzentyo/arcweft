pub character layout_agent {
    display = "Layout Coverage"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Arcweft Demo"
                color = rgb("#f8fbff")
                size = 28px
            }
        }
    }
}

pub style coverage_panel {
    .dialogue_panel {
        background = rgba(17, 18, 16, 242)
    }
    .dialogue_action {
        background = rgba(0, 0, 0, 0)
    }
    .coverage_panel {
        font-family = text("Arcweft Demo")
        color = rgba(248, 251, 255, 255)
        font-size = 28000milli
    }
}

pub view CoveragePanel(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px, part = dialogue_panel) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .style(@style.coverage_panel)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
}

pub dialogue defaults {
    view = @view.CoveragePanel
}

entry game @entry.css_layout_cascade_coverage {
    goto @flow.css_layout_cascade_coverage
}

flow css_layout_cascade_coverage {
    layout_agent(id=@say.css_layout_cascade_coverage.main, voice=auto):
        CSS layout/cascade coverage uses a retained View fixture separate from text raster parity.[p]
        Supported selector, flex, gap, padding, size, overflow, and z-index paths are represented together with explicit diagnostics for grid, container queries, pseudo-elements, and structural selectors.[p]

    return "css_layout_cascade_coverage_done"
}
