pub character stylist {
    display = "Style Guide"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Arcweft Demo"
                color = rgb("#ecf7ff")
                size = 24px
            }
        }
    }
}

pub style style_panel {
    .dialogue_panel {
        background = rgba(17, 18, 16, 242)
    }
    .dialogue_action {
        background = rgba(0, 0, 0, 0)
    }
    .style_panel {
        font-family = text("Arcweft Demo")
        color = rgba(248, 251, 255, 255)
        font-size = 24000milli
    }
}

pub view StylePanel(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px, part = dialogue_panel) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .style(@style.style_panel)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
}

pub dialogue defaults {
    view = @view.StylePanel
    rich_text {
        ruby {
            size = 10px
            gap = 1px
        }
    }
}

style css_style_parity {
  token font.display_stack: FontFamilyList = [
    "Arcweft Demo",
    "Yu Gothic",
    "Hiragino Sans",
    "Noto Sans JP",
    system_font(.Ui),
  ]
  token color.panel: Color = rgba(15, 21, 31, 238)
  token color.panel_hover: Color = rgba(30, 44, 59, 242)
  token color.accent: Color = rgba(100, 210, 200, 255)
  token color.selection: Color = rgba(100, 210, 200, 96)
  token metric.corner_lg: Length = 8px
  token metric.focus_ring: Length = 2px
  token motion.hover_lift: Length = -3px
  token motion.pressed_scale: Scalar = 970milli

  Panel {
    background-color = token(color.panel)
    color = system_color(.SurfaceText)
    font-family = token(font.display_stack)
  }

  Button {
    background-color = token(color.panel)
    color = system_color(.AccentText)
    border-radius = token(metric.corner_lg)
    opacity = 1000milli
    scale = 1000milli
    translate-y = 0px
  }

  Button:hover {
    background-color = token(color.panel_hover)
    color = token(color.accent)
    translate-y = token(motion.hover_lift)
  }

  Button:active {
    opacity = 920milli
    scale = token(motion.pressed_scale)
  }

  Button:focus-visible {
    outline-color = system_color(.FocusRing)
    outline-width = token(metric.focus_ring)
  }

  TextField {
    caret-color = token(color.accent)
    selection-color = token(color.selection)
    placeholder-color = system_color(.MutedText)
    border-radius = token(metric.corner_lg)
  }

  TextField:composing {
    composition-underline-color = token(color.accent)
  }

  TextField:placeholder-shown {
    color = system_color(.MutedText)
  }
}

entry game @entry.css_style_parity {
    goto @flow.css_style_parity
}

flow css_style_parity {
    stylist(id=@say.css_style_parity.main, voice=auto):
        [font "Arcweft Demo"][color #64d2c8][size 31]DSL-styled text[/size][/color][/font] uses [color #f6cc66]color[/color], [size 32]size[/size], [strong]strong[/strong], [em]emphasis[/em], |[星影](ほしかげ), [style .opacity 0.86][transform .offset x=6px y=-1px][color #9be7ff]opacity plus offset[/color][/transform][/style], and [effect .wave amp=2px dir=0,1 period=8 speed=1][color #b7f58b]wave motion[/color][/effect] in one Arcweft-rendered paragraph.[p]

    stylist(id=@say.css_style_parity.wrap, voice=auto):
        [color #9be7ff]Styled paragraph wrap probe:[/color] one sentence crosses [strong]bold[/strong], [color #f6cc66]warm color[/color], and [size 34]larger glyph[/size] spans so the paragraph wraps as one body.[p]

    choice @choice.css_style_parity {
        @choice.css_style_parity.accept "Keep styled route" -> @flow.done
        @choice.css_style_parity.inspect "Inspect parity metrics" -> @flow.done
    }
}

flow done {
    stylist(id=@say.css_style_parity.done, voice=auto):
        Native and Web consumed the same Arcweft frame plan.[p]
    return "css_style_parity_done"
}
