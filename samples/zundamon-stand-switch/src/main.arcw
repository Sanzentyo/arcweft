pub character zundamon {
    display = "ずんだもん"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Yu Gothic"
                color = rgb("#9fe66f")
                size = 27px
            }
        }
    }
}

pub character narrator {
    display = "語り手"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Yu Mincho"
                color = rgb("#efd6c4")
                size = 23px
            }
        }
    }
}

pub style zundamon_panel {
    .dialogue_panel {
        background-color = rgba(17, 18, 16, 242)
    }
    .dialogue_action {
        background-color = rgba(0, 0, 0, 0)
    }
    .zundamon_panel {
        font-family = ["Yu Gothic UI"]
        color = rgba(247, 244, 232, 255)
        font-size = 24px
    }
}

pub view ZundamonPanel(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px, part = dialogue_panel) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .style(@style.zundamon_panel)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
}

pub image @image.zundamon.normal {
    asset = @asset:.zundamon.normal
    id = "image.zundamon.stand"
    target = "target.zundamon.stand"
    layer = "layer.character"
    position = anchor(top_right)
    object_anchor = top_right
    margin.top = 20px
    margin.right = 100px
    size.width = 250px
    size.height = 430px
    scale = design
    fit = "contain"
    alignment.x = "center"
    alignment.y = "bottom"
    depth = 1000
}

pub image @image.zundamon.smile {
    asset = @asset:.zundamon.smile
    id = "image.zundamon.stand"
    target = "target.zundamon.stand"
    layer = "layer.character"
    position = anchor(top_right)
    object_anchor = top_right
    margin.top = 20px
    margin.right = 100px
    size.width = 250px
    size.height = 430px
    scale = design
    fit = "contain"
    alignment.x = "center"
    alignment.y = "bottom"
    depth = 1000
}

struct GameState {
    started: bool
}

enum GameEvent {
    Start
}

fn initial_game_state() -> GameState
effects {}
{
    GameState { started = false }
}

fn reduce_game(state: &GameState, event: GameEvent)
    -> Result<Reduction<GameState>, ReducerError>
effects {}
{
    Ok(Reduction.unchanged(state))
}

entry game @entry.main {
    state = GameState
    initializer = initial_game_state
    event = GameEvent
    reducer = reduce_game
    goto @flow.normal
}

flow normal(state: GameState) {
    image(@image.zundamon.normal)

    narrator(id=@say.zundamon.intro, voice=auto):
        立ち絵はローカル生成されたずんだもん素材を使う。語り手は別characterなので、色とフォントが明確に違う。[p]

    zundamon(id=@say.zundamon.normal, voice=auto, look=.normal):
        ぼくのcharacter styleでは緑の文字になるのだ。既定のタイプライターで表示されて、[.wave amp=4px freq=8]この部分だけ少し揺れる[/]のだ。[p]

    choice @choice.zundamon.normal {
        @choice.zundamon.to_smile "笑顔に切り替える" -> @flow.smile
        @choice.zundamon.finish_normal "この表情で終わる" -> @flow.done_normal
    }
}

flow smile {
    image(@image.zundamon.smile)

    zundamon(id=@say.zundamon.smile, voice=auto, look=.smile):
        smile の look と画像objectを同じ場面で切り替えたのだ。choiceは固定位置なので、スクロールしても上下しないのだ。[p]

    choice @choice.zundamon.smile {
        @choice.zundamon.to_normal "通常表情に戻す" -> @flow.normal
        @choice.zundamon.finish_smile "笑顔のまま終わる" -> @flow.done_smile
    }
}

flow done_normal {
    narrator(id=@say.zundamon.done_normal, voice=auto):
        通常表情のまま終了。nativeでもWASMでも同じフレーム計画を使っている。[p]
    return "done_normal"
}

flow done_smile {
    narrator(id=@say.zundamon.done_smile, voice=auto):
        笑顔で終了。character style、画像、choiceの表示をまとめて確認できる。[p]
    return "done_smile"
}
