pub character designer {
    display = "Reactive View"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Arcweft Demo"
                color = rgb("#f7fbff")
                size = 27px
            }
        }
    }
}

pub style reactive_panel {
    .dialogue_panel {
        background = rgba(17, 18, 16, 242)
    }
    .dialogue_action {
        background = rgba(0, 0, 0, 0)
    }
    .reactive_panel {
        font-family = text("Arcweft Demo")
        color = rgba(247, 251, 255, 255)
        font-size = 27000milli
    }
}

pub view ReactivePanel(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px, part = dialogue_panel) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .style(@style.reactive_panel)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
}

pub dialogue defaults {
    view = @view.ReactivePanel
    rich_text {
        ruby {
            size = 12px
            gap = 1px
        }
    }
}

entry game @entry.reactive_view_style {
    goto @flow.reactive_view_style
}

flow reactive_view_style {
    designer(id=@say.reactive_view_style.intro, voice=auto):
        [font "Arcweft Demo"][color #64d2c8]Reactive View style sample[/color][/font] bundles Arcweft View style resources and CSS source identity together.[r]
        Hover and press the choices below. The current player path renders choice interaction states through the shared renderer, while the product View sidecars record the intended Arcweft-style and CSS-style layers for the retained View path.[p]

    choice @choice.reactive_view_style {
        @choice.reactive_view_style.primary "Primary button: hover + press" -> @flow.primary
        @choice.reactive_view_style.secondary "Secondary button: focus ring" -> @flow.secondary
        @choice.reactive_view_style.disabled "Disabled visual contract sample" -> @flow.disabled
    }
}

flow primary {
    designer(id=@say.reactive_view_style.primary, voice=auto):
        Primary activation reached the Arcweft runtime path.[p]
    return "reactive_view_style_primary"
}

flow secondary {
    designer(id=@say.reactive_view_style.secondary, voice=auto):
        Secondary activation reached the Arcweft runtime path.[p]
    return "reactive_view_style_secondary"
}

flow disabled {
    designer(id=@say.reactive_view_style.disabled, voice=auto):
        This option is intentionally still selectable until product View disabled-state routing is connected.[p]
    return "reactive_view_style_disabled"
}
