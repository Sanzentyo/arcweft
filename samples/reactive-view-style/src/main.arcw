pub character designer {
    display = "Reactive View"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Arcweft Demo"
                color = rgb("#f7fbff")
                size = 27px
            }
        }
    }
}

pub style reactive_panel {
    .dialogue_panel {
        background-color = rgba(17, 18, 16, 242)
    }
    .dialogue_action {
        background-color = rgba(0, 0, 0, 0)
    }
    .dialogue_content {
        font-family = ["Arcweft Demo"]
        color = rgba(247, 251, 255, 255)
        font-size = 27px
    }
}

pub style reactive_interaction {
    token font.view_stack: FontFamilyList = [
        "Arcweft Demo",
        "Yu Gothic",
        "Hiragino Sans",
        "Noto Sans JP",
        system_font(.Ui),
    ]
    token color.canvas: Color = rgba(13, 18, 31, 255)
    token color.button: Color = rgba(26, 45, 76, 255)
    token color.button_hover: Color = rgba(43, 85, 132, 255)
    token color.button_active: Color = rgba(17, 103, 117, 255)
    token color.accent: Color = rgba(116, 230, 218, 255)
    token metric.corner: Length = 8px

    Panel {
        background-color = token(color.canvas)
        color = system_color(.SurfaceText)
        font-family = token(font.view_stack)
    }

    Button {
        background-color = token(color.button)
        border-radius = token(metric.corner)
        color = system_color(.AccentText)
    }

    Button:hover {
        background-color = token(color.button_hover)
        translate-y = -1px
    }

    Button:active {
        background-color = token(color.button_active)
        scale = 970milli
    }

    Button:focus-visible {
        outline-color = token(color.accent)
        outline-width = 3px
    }

    Button:disabled {
        opacity = 520milli
    }
}

pub view ReactivePanel(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .part(dialogue_content)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
        .part(dialogue_panel)
        .style(@style.reactive_panel)
        .style(@style.reactive_interaction)
}

pub dialogue defaults {
    view = @view.ReactivePanel
    rich_text {
        ruby {
            size = 12px
            gap = 1px
        }
    }
}

entry game @entry.reactive_view_style {
    goto @flow.reactive_view_style
}

flow reactive_view_style {
    designer(id=@say.reactive_view_style.intro, voice=auto):
        [font "Arcweft Demo"][color #64d2c8]Reactive View style sample[/color][/font] bundles typed, sheet-owned native Style resources.[r]
        Hover and press the choices below. The shared renderer consumes the same ordered native Style applications for each interaction state.[p]

    choice @choice.reactive_view_style {
        @choice.reactive_view_style.primary "Primary button: hover + press" -> @flow.primary
        @choice.reactive_view_style.secondary "Secondary button: focus ring" -> @flow.secondary
        @choice.reactive_view_style.disabled "Disabled visual contract sample" -> @flow.disabled
    }
}

flow primary {
    designer(id=@say.reactive_view_style.primary, voice=auto):
        Primary activation reached the Arcweft runtime path.[p]
    return "reactive_view_style_primary"
}

flow secondary {
    designer(id=@say.reactive_view_style.secondary, voice=auto):
        Secondary activation reached the Arcweft runtime path.[p]
    return "reactive_view_style_secondary"
}

flow disabled {
    designer(id=@say.reactive_view_style.disabled, voice=auto):
        This option is intentionally still selectable until product View disabled-state routing is connected.[p]
    return "reactive_view_style_disabled"
}
