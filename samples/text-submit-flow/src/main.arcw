pub character narrator {
  display = "Arcweft Text Submit"
}

pub action feedback.submit(value: String)

struct GameState {
  started: bool
}

enum GameEvent {
  Start
}

fn initial_game_state() -> GameState
effects {}
{
  GameState { started = false }
}

fn reduce_game(state: &GameState, event: GameEvent)
    -> Result<Reduction<GameState>, ReducerError>
effects {}
{
  Ok(Reduction.unchanged(state))
}

entry game @entry.text_submit_flow {
  state = GameState
  initializer = initial_game_state
  event = GameEvent
  reducer = reduce_game
  goto @flow.text_submit_flow
}

pub style primary_button {
  Button:hover {
    background-color = rgba(54, 190, 170, 255)
  }

  Button:active {
    background-color = rgba(42, 156, 140, 255)
  }
}

pub view FeedbackForm() {
  local state mut feedback_text: String = ""

  Column {
    TextField(feedback_text, target = @input:.feedback, label = "Message",
              placeholder = "Type text, then press Enter or click Send",
              purpose = .text, enter_key = .send)
      .on_submit(|| feedback.submit(value = feedback_text))

    Button("Send", target = @button:.feedback_send, enabled = true)
      .style(@style:.primary_button)
      .on_click(|| feedback.submit(value = feedback_text))
  }
}

flow text_submit_flow(state: GameState) -> String {
  let panel = mount(FeedbackForm())

  narrator:
    Type a short message in the Arcweft-rendered field.[p]
    Press Enter, use the IME send/done action, or activate the Send button.

  let event = await receive(feedback.submit)
  let submitted = event.value
  let character_count = submitted.scalar_count()

  if character_count == 0usize {
    narrator: Nothing was submitted.
  }

  if character_count > 0usize {
    narrator: Submitted #[submitted].
  }

  if character_count < 5usize {
    narrator: The submitted text is short: #[character_count] Unicode scalar value(s).
  }

  if character_count >= 5usize {
    narrator: The submitted text has #[character_count] Unicode scalar value(s), so it takes the longer branch.
  }

  return submitted
}
