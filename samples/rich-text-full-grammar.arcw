pub character alice {
    display = "Alice"
}

pub character bob {
    display = "Bob"
}

pub character narrator {
    display = "Narrator"
}

#[text_proxy(role="keyword", hit_test=true, depth=4px, channel="choice")]
pub struct KeywordHit {
    channel: String
}

#[text_proxy(role="hover", hit_test=false, depth=2px, layer="view", tone="calm")]
pub struct HoverHit {
    tone: String
}

#[fx]
pub fn warning(
    accent: Color = rgb("#ff4050"),
    amplitude: Length = 2px,
    speed: f32 = 1.0,
) -> Fx {
    Fx.stack([
        Fx.text(weight = .strong, color = accent),
        Fx.transform(
            target = .glyph,
            sample = |ctx| Transform2D {
                translate_y:
                    sin(ctx.time * speed + ctx.ordinal_phase()) * amplitude,
            },
        ),
    ])
}

entry cli @entry.rich_text_full_grammar {
    goto @flow.rich_text_full_grammar
}

flow rich_text_full_grammar {
    let player_name = "澪"
    let score: i32 = 42
    let debug_label = "debug-ok"

    alice(id=@say.full.001, voice=auto, look=.smile, rich_text=rich_text_style(ruby=ruby_style(size=13px, gap=0px)), inline_error=InlineFailure.fallback("?"))[
        ルビ: |[変な夢](へんなゆめ)、|[悪夢](あくむ)、｜星影《ほしかげ》、#ruby("時計塔")[時の塔]、#ruby("ゆめ")[夢]、#ruby("ひみつ")[秘密]。[p]
    ]

    alice(id=@say.full.001.extreme, voice=auto, look=.smile, rich_text=rich_text_style(ruby=ruby_style(size=13px, gap=0px)), inline_error=InlineFailure.fallback("?"))[
        極端ルビ: |[政](まつりごと)を行うため、|[中央の帝国将官たち](ぐん)が集まる。[p]
    ]

    alice(id=@say.full.001.vertical_extreme, voice=auto, look=.smile, rich_text=rich_text_style(ruby=ruby_style(size=13px, gap=0px)), inline_error=InlineFailure.fallback("?"))[
        縦極端ルビ: #layout(.vertical_rl, jlreq=.normal)[|[政](まつりごと)を行うため、|[中央の帝国将官たち](ぐん)が集まる。][p]
    ]

    bob(id=@say.full.002, voice=auto, inline_error=InlineFailure.fallback("?"))[
        補間: #[player_name]、#[debug_label]、#[fmt(score, style="number")]点、#[fmt(score, fallback="?")]、#[fmt(score, on_error=.discard)]。[p]
    ]

    narrator(id=@say.full.003, voice=auto)[
        待機と改行: 一行目[l]続き[w time=500ms]短縮待ち[w 250ms]改行[r]クリア[clear][p]
    ]

    alice(id=@say.full.004, voice=auto)[
        装飾: #em()[夢]、#strong()[本当に]、#color(rgb("#a8b5ff"))[夜]、#font("serif")[serif]、#font("Yu Gothic")[游ゴシック]、#size(36pt)[大]、#fx(warning(amplitude=4px, speed=2.0))[再利用Fx]、[speed cps=24]速度[reset]reset後。[p]
    ]

    bob(id=@say.full.005, voice=auto)[
        推論: #style(.italic)[italic]、#style(.oblique, angle=12deg)[oblique]、#layout(.vertical_rl, jlreq=.strict)[吾輩は猫である。ABC 123 2026]、#layout(.vertical_lr)[縦LR]。[r]変形: #transform(.offset, x=4px, y=-2px, target=.glyph)[offset]、#transform(.rotate, angle=8deg, origin=.center, target=.content)[rotate]、#transform(.scale, x=1.2, y=1.2, origin=.baseline_center, target=.content)[scale]。[r]効果: #fx(wave(amplitude=2px, direction=vec2(0.0, 1.0), target=.glyph, phase=.glyph_transform))[wave]、#fx(shake(amplitude=1px))[shake]、#fx(typewriter(characters_per_second=20, phase=.glyph_mask))[typewriter]、#fx(arc(radius=18px, start_angle=-18deg, step_angle=8deg, target=.glyph))[arc]、#fx(sparkle(amplitude=2px))[custom effect]、#fx(sparkle(amplitude=1px))[sparkle]、[mark @.keyword]marker。[p]
    ]

    narrator(id=@say.full.006, voice=auto)[
        明示family: #style(.italic)[style]、#layout(.horizontal_tb)[layout]、#transform(.skew, x=2deg, y=0deg, origin=.glyph_center, target=.glyph)[transform]、#fx(jitter(amplitude=1px, target=.glyph, phase=.glyph_transform))[effect]、#fx(shader(resource=@.soft_glow, amount=0.4, direction=vec2(1.0, 0.0), phase=.offscreen_pass))[shader]、#object(id = @.hotspot, type = KeywordHit)[proxy]、#object(id = @.hotspot2, type = KeywordHit, channel = "inventory")[#object(id = @.hover, type = HoverHit, depth = 7px, hit_test = true, tone = "alert")[multi proxy]]、#object(id = @.KeywordHit, type = KeywordHit, channel = "typed")[typed proxy]、#style(.layer, layer=@.hud)[#style(.z_index, z_index=3)[#style(.opacity, opacity=0.8)[z depth]]]。[p]
    ]

    alice(id=@say.full.007, voice=auto)[
        cue: [voice auto][face @.smile][pose @.idle][show @.alice][hide @.bob][move x=10px y=0px][scale x=1.1][rotate 5deg][anim @.blink][shake amp=2px][at 0.2s call=flash][call flash(color=rgb("#ffffff"), time=90ms)][signal @.seen]条件と代替の表示[mark @.release][p]
    ]

    bob(id=@say.full.008, voice=auto)[
        raw短縮 #raw()[[p]や#[expr]をそのまま表示] と escape #font("Consolas")[\[ \] \# \$ \( \) \| \{ \} \: \｜ \《 \》 \\]。[p]
    ]

    narrator(id=@say.full.009, voice=auto)[
        #raw()[
        raw block: [p] も [.shake] も #[player_name] も解釈しない。
        ][p]
    ]

    return "rich_text_full_grammar"
}
