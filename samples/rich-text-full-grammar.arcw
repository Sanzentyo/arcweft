pub surface character alice {
    display = "Alice"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Yu Gothic"
                color = rgb("#d9f2ff")
                size = 29px
            }
        }
    }
}

pub surface character bob {
    display = "Bob"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Meiryo"
                color = rgb("#ffe0d0")
                size = 28px
            }
        }
    }
}

pub surface character narrator {
    display = "Narrator"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Segoe UI"
                color = rgb("#e8e8e8")
                size = 27px
            }
        }
    }
}

#[text_proxy(kind="keyword", default_hit=true, depth=4, channel=choice)]
pub struct KeywordHit {
    channel: String
}

#[text_proxy(kind="hover", default_hit=false, depth=2, layer=view)]
pub struct HoverHit {
    layer: String
}

pub dialogue defaults @dialogue:.defaults.full {
    rich_text {
        layout {
            writing_mode = horizontal_tb
            jlreq = normal
            vertical_latin = mixed
        }
        ruby {
            position = over
            size = 12px
            gap = 1px
            overhang = 3px
            collision_gap = 2px
        }
    }
    inline_error = InlineFailure.fallback("?")
}

entry game {
    goto @flow.rich_text_full_grammar
}

flow rich_text_full_grammar {
    let player_name = "澪"
    let score: i32 = 42
    let debug_label = "debug-ok"

    alice.say(id=@say.full.001, voice=auto, look=.smile, rich_text=rich_text_style(ruby=ruby_style(size=13px, gap=0px)), inline_error=InlineFailure.fallback("?"))[
        ルビ: |[変な夢](へんなゆめ)、|悪夢{あくむ}、｜星影《ほしかげ》、[ruby rt="時計塔"]時の塔[/ruby]、[rb rt=ゆめ]夢[/rb]、#[ruby("秘密", "ひみつ")]。[p]
    ]

    alice.say(id=@say.full.001.extreme, voice=auto, look=.smile, rich_text=rich_text_style(ruby=ruby_style(size=13px, gap=0px)), inline_error=InlineFailure.fallback("?"))[
        極端ルビ: |[政](まつりごと)を行うため、|[中央の帝国将官たち](ぐん)が集まる。[p]
    ]

    alice.say(id=@say.full.001.vertical_extreme, voice=auto, look=.smile, rich_text=rich_text_style(ruby=ruby_style(size=13px, gap=0px)), inline_error=InlineFailure.fallback("?"))[
        縦極端ルビ: [.vertical_rl jlreq=normal]|[政](まつりごと)を行うため、|[中央の帝国将官たち](ぐん)が集まる。[/][p]
    ]

    bob.say(id=@say.full.002, voice=auto, inline_error=InlineFailure.fallback("?"))[
        補間: #[player_name]、$(debug_label)、#[fmt(score, style="number")]点、#[fmt(score, fallback="?")]、#[fmt(score, on_error=.discard)]。[p]
    ]

    narrator.say(id=@say.full.003, voice=auto)[
        待機と改行: 一行目[l]続き[w time=500ms]短縮待ち[w 250ms]改行[r]br別名[br]wait別名[wait]nl別名[nl]ページ別名[page]クリア[clear][er][cm][p]
    ]

    alice.say(id=@say.full.004, voice=auto)[
        装飾: [em:夢]、[strong:本当に]、[color #a8b5ff:夜]、[font serif]serif[/font]、[font "Yu Gothic"]游ゴシック[/font]、[size 36]大[/size]、[speed cps=24]速度[/speed]、[reset]reset後。[p]
    ]

    bob.say(id=@say.full.005, voice=auto)[
        推論: [.italic]italic[/]、[.oblique 12deg]oblique[/]、[.vertical_rl jlreq=strict]吾輩は猫である。ABC 123 2026[/]、[.vertical_lr]縦LR[/]。[r]変形: [.offset x=4px y=-2px target=glyph]offset[/]、[.rotate angle=8deg origin=center target=run]rotate[/]、[.scale x=1.2 y=1.2 origin=baseline_center target=run]scale[/]。[r]効果: [.wave amp=2px dir=0,1 target=glyph phase=glyph_transform]wave[/]、[.shake amp=1px seed=full state_scope=glyph]shake[/]、[.typewriter cps=20 phase=glyph_mask]typewriter[/]、[.arc radius=18px start=-18deg step=8deg target=glyph]arc[/]、[.sparkle amp=2px seed=custom state_scope=run]custom effect[/]、[.host id=sparkle amp=1px seed=host]host[/]、[.keyword]marker。[p]
    ]

    narrator.say(id=@say.full.006, voice=auto)[
        明示family: [style .italic]style[/style]、[layout .horizontal_tb]layout[/layout]、[transform .skew x=2deg y=0deg origin=glyph_center target=glyph]transform[/transform]、[effect .jitter amp=1px seed=full target=glyph phase=glyph_transform state_scope=glyph]effect[/effect]、[effect .shader id=soft_glow amount=0.4 dir=1,0 phase=run_offscreen_pass]shader[/effect]、[object .hotspot type=KeywordHit]proxy[/object]、[object .hotspot2 type=KeywordHit channel=inventory][object .hover type=HoverHit depth=7 hit=true tone=alert]multi proxy[/object][/object]、[.KeywordHit channel=typed]typed proxy[/]、[style .layer hud][style .z_index 3][style .opacity 0.8][style .meta role=caption hover=true]z depth[/style][/style][/style][/style]。[p]
    ]

    alice.say(id=@say.full.007, voice=auto)[
        cue: [voice auto][face smile][pose idle][show alice][hide bob][move x=10 y=0][scale x=1.1][rotate 5deg][anim blink][shake amp=2][at 0.2s call=flash][call flash(color=#ffffff, time=90ms)][! sparkle(intensity=2)][signal .seen][if flag]条件[else]代替[endif][mark .release][p]
    ]

    bob.say(id=@say.full.008, voice=auto)[
        raw短縮 [raw: [p]や#[expr]をそのまま表示] と escape [font "Consolas"]\[ \] \# \$ \( \) \| \{ \} \: \｜ \《 \》 \\[/font]。[p]
    ]

    narrator.say(id=@say.full.009, voice=auto)[
        [raw]
        raw block: [p] も [.shake] も #[player_name] も解釈しない。
        [/raw][p]
    ]

    return "rich_text_full_grammar"
}
