pub character layout_agent {
    display = "Layout Coverage"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Arcweft Demo"
                color = rgb("#f8fbff")
                size = 28px
            }
        }
    }
}

pub style coverage_panel {
    token color.canvas: Color = rgba(16, 24, 32, 255)
    token color.panel: Color = rgba(30, 44, 59, 242)
    token color.accent: Color = rgba(100, 210, 200, 255)
    token metric.corner: Length = 12px

    Panel {
        background-color = token(color.canvas)
        color = rgba(248, 251, 255, 255)
        border-radius = token(metric.corner)
        overflow = .Hidden
    }

    Button {
        background-color = token(color.panel)
        color = token(color.accent)
        border-radius = token(metric.corner)
        opacity = 1000milli
        z-index = 1
    }

    Button:hover {
        opacity = 920milli
        z-index = 2
    }

    .dialogue_panel {
        background-color = rgba(17, 18, 16, 242)
    }
    .dialogue_action {
        background-color = rgba(0, 0, 0, 0)
    }
    .coverage_panel {
        font-family = ["Arcweft Demo"]
        color = rgba(248, 251, 255, 255)
        font-size = 28px
    }
}

pub view CoveragePanel(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px, part = dialogue_panel) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .part(coverage_panel)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
        .style(@style.coverage_panel)
}

pub dialogue defaults {
    view = @view.CoveragePanel
}

entry game @entry.native_style_layout_coverage {
    goto @flow.native_style_layout_coverage
}

flow native_style_layout_coverage {
    layout_agent(id=@say.native_style_layout_coverage.main, voice=auto):
        Native Style layout coverage uses a retained View fixture separate from text raster parity.[p]
        Typed selectors, tokens, overflow, radius, opacity, interaction state, and z-index are represented in one sheet-owned application.[p]

    return "native_style_layout_coverage_done"
}
