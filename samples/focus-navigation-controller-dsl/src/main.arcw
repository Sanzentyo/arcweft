pub character narrator {
  display = "Arcweft Focus Navigation"
  default_voice = auto
}

pub action settings.apply(value: String)

struct GameState {
  started: bool
}

enum GameEvent {
  Start
}

fn initial_game_state() -> GameState
effects {}
{
  GameState { started = false }
}

fn reduce_game(state: &GameState, event: GameEvent)
    -> Result<Reduction<GameState>, ReducerError>
effects {}
{
  Ok(Reduction.unchanged(state))
}

entry game @entry.focus_navigation_controller_dsl {
  state = GameState
  initializer = initial_game_state
  event = GameEvent
  reducer = reduce_game
  goto @flow.focus_navigation_controller_dsl
}

pub view FocusNavigationControllerSample() {
  let name = input.text(@input:.name, initial = "Aster")
  let notes = input.text(@input:.notes, initial = "Notes")

  Column(nav: .vertical, group: @group:.settings, wrap: false, initial: @input:.name, trap: .modal) {
    Row(nav: .horizontal, group: @group:.settings.row_one, parent: @group:.settings, wrap: true) {
      TextField(name)
        .label("Name")
        .nav(right: @button:.apply, down: @input:.notes, previous: boundary)

      Button(@button:.apply, label = "Apply")
        .nav(left: @input:.name, down: @button:.danger, next: @input:.notes)
        .on_click {
          action.invoke(@action:.settings.apply, value = name.text)
        }
    }

    Row(nav: .horizontal, group: @group:.settings.row_two, parent: @group:.settings, wrap: true) {
      TextArea(notes)
        .label("Notes")
        .nav(up: @input:.name, right: @button:.close)

      Button(@button:.danger)
        .label("Danger disabled")
        .enabled(false)
        .nav(up: @button:.apply, left: auto, right: @button:.close)

      Button(@button:.close)
        .label("Close")
        .nav(left: @input:.notes, up: @button:.apply, next: boundary)
    }
  }
}

flow focus_navigation_controller_dsl(state: GameState) {
  view(@view:.FocusNavigationControllerSample)

  narrator:
    Focus navigation controller sample.

  return "focus_navigation_controller_dsl_open"
}
