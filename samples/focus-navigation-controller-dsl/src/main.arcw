pub character narrator {
  display = "Arcweft Focus Navigation"
  default_voice = auto
}

entry game @entry.focus_navigation_controller_dsl {
  goto @flow.focus_navigation_controller_dsl
}

pub component FocusNavigationControllerSample() {
  Column(nav: .vertical, group: @group:.settings, wrap: false, initial: @input:.name, trap: .modal) {
    Row(nav: .horizontal, group: @group:.settings.row_one, parent: @group:.settings, wrap: true) {
      TextField(@input:.name, value: "Aster")
        .label("Name")
        .nav(right: @button:.apply, down: @input:.notes, previous: boundary)

      Button(@button:.apply)
        .label("Apply")
        .nav(left: @input:.name, down: @button:.danger, next: @input:.notes)
        .on_click(|| text_submit @input:.name)
    }

    Row(nav: .horizontal, group: @group:.settings.row_two, parent: @group:.settings, wrap: true) {
      TextArea(@input:.notes, value: "Notes")
        .label("Notes")
        .nav(up: @input:.name, right: @button:.close)

      Button(@button:.danger)
        .label("Danger disabled")
        .enabled(false)
        .nav(up: @button:.apply, left: auto, right: @button:.close)

      Button(@button:.close)
        .label("Close")
        .nav(left: @input:.notes, up: @button:.apply, next: boundary)
    }
  }
}

flow focus_navigation_controller_dsl {
  component(@component:.FocusNavigationControllerSample)

  narrator:
    Focus navigation controller sample.

  return "focus_navigation_controller_dsl_open"
}
