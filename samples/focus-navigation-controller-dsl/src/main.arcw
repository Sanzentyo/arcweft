pub surface character narrator {
  display = "Arcweft Focus Navigation"
  default_voice = auto
}

entry game @entry.focus_navigation_controller_dsl {
  start @flow.focus_navigation_controller_dsl
}

pub component FocusNavigationControllerSample() -> View {
  VStack(nav: .vertical, group: @group:.settings, wrap: false, initial: @input:.name, trap: .modal) {
    HStack(nav: .horizontal, group: @group:.settings.row_one, parent: @group:.settings, wrap: true) {
      TextField(@input:.name, value: "Aster", label: "Name")
        .nav(right: @button:.apply, down: @input:.notes, previous: boundary)

      Button("Apply", id: @button:.apply)
        .nav(left: @input:.name, down: @button:.danger, next: @input:.notes)
        .on_click(ime: .commit) {
          text_submit @input:.name
        }
    }

    HStack(nav: .horizontal, group: @group:.settings.row_two, parent: @group:.settings, wrap: true) {
      TextArea(@input:.notes, value: "Notes", label: "Notes")
        .nav(up: @input:.name, right: @button:.close)

      Button("Danger disabled", id: @button:.danger, enabled: false)
        .nav(up: @button:.apply, left: auto, right: @button:.close)

      Button("Close", id: @button:.close)
        .nav(left: @input:.notes, up: @button:.apply, next: boundary)
    }
  }
}

flow focus_navigation_controller_dsl {
  narrator:
    Focus navigation controller sample.

  return "focus_navigation_controller_dsl_open"
}
