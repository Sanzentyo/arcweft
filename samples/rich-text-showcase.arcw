pub character alice {
    display = "Alice"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Yu Gothic"
                color = rgb("#d9f2ff")
                size = 30px
            }
        }
    }
}

pub character narrator {
    display = "Narrator"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Yu Gothic UI"
                color = rgb("#e8e8e8")
                size = 28px
            }
        }
    }
}

pub character benio {
    display = "Benio"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Meiryo"
                color = rgb("#ffd9e8")
                size = 29px
            }
        }
    }
}

pub character clerk {
    display = "Clerk"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "MS Gothic"
                color = rgb("#e8ffd9")
                size = 27px
            }
        }
    }
}

pub style rich_text_panel {
    .dialogue_panel {
        background-color = rgba(17, 18, 16, 242)
    }
    .dialogue_action {
        background-color = rgba(0, 0, 0, 0)
    }
    .rich_text_panel {
        color = rgba(205, 239, 255, 255)
    }
}

pub view RichTextPanel(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px, part = dialogue_panel) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .style(@style.rich_text_panel)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
}

pub dialogue defaults {
    view = @view.RichTextPanel
    rich_text {
        layout {
            writing_mode = horizontal_tb
            jlreq = normal
            vertical_latin = mixed
        }
        ruby {
            size = 13px
            gap = 1px
            overhang = 3px
            collision_gap = 2px
        }
    }
}

struct GameState {
    started: bool
}

enum GameEvent {
    Start
}

fn initial_game_state() -> GameState
effects {}
{
    GameState { started = false }
}

fn reduce_game(state: &GameState, event: GameEvent)
    -> Result<Reduction<GameState>, ReducerError>
effects {}
{
    Ok(Reduction.unchanged(state))
}

entry game @entry.main {
    state = GameState
    initializer = initial_game_state
    event = GameEvent
    reducer = reduce_game
    goto @flow.rich_text_showcase
}

flow rich_text_showcase(state: GameState) {
    let alice_panel = alice(text_color="#9fdcff")

    alice_panel(id=@say.rich_text.001, voice=auto, look=.smile, text_color="#8fd7ff", rich_text=rich_text_style(ruby=ruby_style(size=11px, gap=1px)))[
        [font "Yu Gothic"][color #8fd7ff]光る[/color][.wave amp=3px dir=0,1 period=8 speed=1]波[/]と、[.shake amp=1px seed=demo]震える声[/]。[.offset x=12px y=-4px]|[星屑](ほしくず)[/]が浮いて、[.vertical_rl][font "Yu Mincho"]縦書きも混ざる[/font][/]。[p]
    ]

    narrator.say(id=@say.rich_text.002, voice=auto)[
        [font "Segoe UI"]Segoe UI[/font] と [font "Consolas"]Consolas 123[/font]、[font "MS Mincho"]明朝[/font]、[font "Meiryo"]メイリオ[/font] を同じ行で確認する。[p]
    ]

    benio.say(id=@say.rich_text.003, voice=auto, look=.confident)[
        [strong]太字[/strong]、[em]強調[/em]、[italic]italic[/italic]、[oblique 12deg]斜体角度[/oblique]、[size 36]大きな文字[/size]、[color #ff9ac8]色指定[/color]。[p]
    ]

    clerk.say(id=@say.rich_text.004, voice=auto)[
        [.vertical_rl][font "MS Mincho"]縦書き専用行。春夏秋冬、天地左右、和文の詰まりを見る。[/font][/] [font "MS Gothic"]横組み MS Gothic で比較[/font]。[p]
    ]

    narrator.say(id=@say.rich_text.005, voice=auto)[
        [.jitter amp=1px seed=still]静かな揺らぎ[/]、[.arc radius=24px start=-20deg step=10deg]円弧配置[/]、[.shader id=soft_glow amount=0.6 dir=1,0]shader参照[/]、[.typewriter cps=18]typewriter[/] を保持する。[p]
    ]

    alice.say(id=@say.rich_text.006, voice=auto)[
        [.keyword]未知の dot selector は marker として残し、[reset][font "Yu Gothic"]reset 後の通常文字[/font]へ戻す。[p]
    ]

    return "rich_text_showcase"
}
