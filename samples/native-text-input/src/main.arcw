pub character narrator {
  display = "Arcweft Native IME"
  default_voice = auto
}

struct GameState {
  started: bool
}

enum GameEvent {
  Start
}

fn initial_game_state() -> GameState
effects {}
{
  GameState { started = false }
}

fn reduce_game(state: &GameState, event: GameEvent)
    -> Result<Reduction<GameState>, ReducerError>
effects {}
{
  Ok(Reduction.unchanged(state))
}

entry game @entry.native_text_input_sample {
  state = GameState
  initializer = initial_game_state
  event = GameEvent
  reducer = reduce_game
  goto @flow.native_text_input_sample
}

style native_text_input_sample {
  token font.jp_sans_stack: FontFamilyList = ["Yu Gothic", "Hiragino Sans", "Noto Sans JP", system_font(.Ui)]
  token font.jp_serif_stack: FontFamilyList = ["Yu Mincho", "Hiragino Mincho ProN", "Noto Serif JP", system_font(.Serif)]
  token style.focus_ring_width: Length = 2px

  TextField {
    font-family = token(font.jp_sans_stack)
    border-color = system_color(.Border)
  }

  TextArea {
    font-family = token(font.jp_serif_stack)
    line-height = 27px
  }

  SecureField {
    font-family = [system_font(.Ui)]
  }

  TextField:focus-visible {
    focus-ring-color = system_color(.FocusRing)
    focus-ring-width = token(style.focus_ring_width)
  }

  TextArea:focus-visible {
    focus-ring-color = system_color(.FocusRing)
    focus-ring-width = token(style.focus_ring_width)
  }

  SecureField:focus-visible {
    focus-ring-color = system_color(.FocusRing)
    focus-ring-width = token(style.focus_ring_width)
  }
}

pub view NativeTextInputPanel() {
  let jp_text_field = input.text(@input:.jp_text_field, initial = "Tokyo")
  let jp_text_area = input.text(@input:.jp_text_area, initial = "line one")
  let secret_secure_field = input.secure(@input:.secret_secure_field, initial = "sekret-1234")

  Column {
    TextField(jp_text_field)
      .label("Japanese TextField / 日本語入力")
      .placeholder("日本語 IME text")
      .purpose(.text)
      .enter_key(.done)
      .style(@style:.native_text_input_sample)

    TextArea(jp_text_area)
      .label("Multiline TextArea / 複数行")
      .placeholder("複数行の IME text")
      .purpose(.text)
      .enter_key(.enter)
      .style(@style:.native_text_input_sample)

    SecureField(secret_secure_field)
      .label("SecureField / redacted")
      .placeholder("secret")
      .purpose(.password)
      .enter_key(.done)
      .style(@style:.native_text_input_sample)
  }
}

fn i_to_string(i: i32) -> String {
    if i == 0 {
        return "first"
    } else {
        return "last"
    }
}

fn i_to_string_2(i: i32) -> String {
    if i == 0 {
        return "first"
    } else if i == 1 {
        return "second"
    } else {
        return "last"
    }
}

flow native_text_input_sample(state: GameState) {
  view(@view:.NativeTextInputPanel)

    let a: i32 = 2

    for i in 0i32..a {
        narrator: This is a native text input sample. Iteration #[
            i_to_string(i)
        ] of #[a].
    }
  narrator:
    Native player-rendered IME acceptance sample.[p]
    This scene owns three Arcweft-rendered text controls declared in this DSL source: jp_text_field, jp_text_area, and secret_secure_field.[p]
    Use pointer focus or keyboard traversal to focus a control, then enter Latin or Japanese text with the active platform IME.[p]
    Local trace output belongs under target/native-text-input-trace/.

  return "native_text_input_sample_open"
}
