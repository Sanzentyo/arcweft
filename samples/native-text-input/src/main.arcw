pub surface character narrator {
    display = "Arcweft Native Text Input"
    default_voice = auto
}

entry game @entry.native_text_input {
    start @flow.native_text_input
}

flow native_text_input {
    narrator:
        seq06.4j native-player platform text input bridge sample.[p]
        This sample is the normal native player entrypoint for future renderer-backed text controls.[p]

    narrator:
        Controls planned by scene-contract: jp_text_field, jp_text_area, secret_secure_field.[p]
        The current renderer still needs focused text input target lowering before live IME can attach.[p]

    return "native_text_input_sample_open"
}
