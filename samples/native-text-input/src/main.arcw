pub character narrator {
  display = "Arcweft Native IME"
  default_voice = auto
}

entry game @entry.native_text_input_sample {
  goto @flow.native_text_input_sample
}

style native_text_input_sample {
  token font.jp_sans_stack = ["Yu Gothic", "Hiragino Sans", "Noto Sans JP", "system-ui"]
  token font.jp_serif_stack = ["Yu Mincho", "Hiragino Mincho ProN", "Noto Serif JP", "serif"]
  token style.focus_ring_width = milli(2000)

  TextField {
    font-family = token(font.jp_sans_stack)
    border-color = system_color(border)
  }

  TextArea {
    font-family = token(font.jp_serif_stack)
    line-height-milli = milli(1350)
  }

  SecureField {
    font-family = text("system-ui")
    secure-mask = text("asterisk")
  }

  TextField:focus-visible {
    focus-ring-color = system_color(focus_ring)
    focus-ring-width-milli = token(style.focus_ring_width)
  }

  TextArea:focus-visible {
    focus-ring-color = system_color(focus_ring)
    focus-ring-width-milli = token(style.focus_ring_width)
  }

  SecureField:focus-visible {
    focus-ring-color = system_color(focus_ring)
    focus-ring-width-milli = token(style.focus_ring_width)
  }

  environment text_scale_at_least_milli = 1000
}

pub component NativeTextInputPanel() {
  Column {
    TextField(@input:.jp_text_field, value: "Tokyo", purpose: text, enter_key: done)
      .label("Japanese TextField / 日本語入力")
      .placeholder("日本語 IME text")
      .style(@style:.native_text_input_sample)

    TextArea(@input:.jp_text_area, value: "line one", purpose: text, enter_key: enter)
      .label("Multiline TextArea / 複数行")
      .placeholder("複数行の IME text")
      .style(@style:.native_text_input_sample)

    SecureField(@input:.secret_secure_field, value: "sekret-1234", purpose: password, enter_key: done)
      .label("SecureField / redacted")
      .placeholder("secret")
      .style(@style:.native_text_input_sample)
  }
}

fn i_to_string(i: i32) -> string {
    if i == 0 {
        return "first"
    } else {
        return "last"
    }
}

fn i_to_string_2(i: i32) -> string {
    if i == 0 {
        return "first"
    } else if i == 1 {
        return "second"
    } else {
        return "last"
    }
}

flow native_text_input_sample {
  component(@component:.NativeTextInputPanel)

    let a: i32 = 2

    for i in 0i32..a {
        narrator: This is a native text input sample. Iteration #[
            i_to_string(i)
        ] of #[a].
    }
  narrator:
    Native player-rendered IME acceptance sample.[p]
    This scene owns three Arcweft-rendered text controls declared in this DSL source: jp_text_field, jp_text_area, and secret_secure_field.[p]
    Use pointer focus or keyboard traversal to focus a control, then enter Latin or Japanese text with the active platform IME.[p]
    Local trace output belongs under target/native-text-input-trace/.

  return "native_text_input_sample_open"
}
