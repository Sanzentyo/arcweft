pub character akira {
    display = "Akira"
}

pub character mio {
    display = "Mio"
}

pub character sen {
    display = "Sen"
}

pub character terminal {
    display = "Terminal"
}

pub character narrator {
    display = "Narrator"
}

entry cli @entry.windows_font_showcase {
    goto @flow.windows_font_showcase
}

flow windows_font_showcase {
    sen(id=@say.windows_fonts.001, voice=auto)[
        #layout(.vertical_rl, jlreq=.normal)[#font("MS Mincho")[縦書きの見本。吾輩は猫である。ABC 123 2026。春夏秋冬、朝昼夕夜、天地左右。]] #font("Yu Gothic")[横書き比較]。[p]
    ]

    akira(id=@say.windows_fonts.002, voice=auto, look=.smile)[
        #font("Yu Gothic")[#color(rgb("#8fd7ff"))[Yu Gothic] は本文寄り。#strong()[太字]、#em()[強調]、#size(36pt)[大きな語]を混ぜる。][p]
    ]

    mio(id=@say.windows_fonts.003, voice=auto, look=.bright)[
        #font("Meiryo")[Meiryo] で、#style(.italic)[italic]、#style(.oblique, angle=10deg)[oblique]、#color(rgb("#ff9ac8"))[色指定]を見る。[p]
    ]

    terminal(id=@say.windows_fonts.004, voice=auto)[
        #font("Consolas")[Consolas: let score = 42; 0123456789] と #font("MS Gothic")[MS Gothic 等幅かな交じり]。[p]
    ]

    narrator(id=@say.windows_fonts.005, voice=auto)[
        #font("Segoe UI")[Segoe UI]、#font("Yu Gothic UI")[Yu Gothic UI]、#font("MS Gothic")[MS Gothic]、#font("MS Mincho")[MS Mincho] を同じ rich text に並べる。[p]
    ]

    akira(id=@say.windows_fonts.006, voice=auto)[
        #fx(wave(amplitude=2px, direction=vec2(0.0, 1.0), period=7, speed=1))[波]、#fx(shake(amplitude=1px))[揺れ]、#transform(.offset, x=8px, y=-3px)[|[星影](ほしかげ)]、#fx(typewriter(characters_per_second=20))[typewriter]。[p]
    ]

    return "windows_font_showcase"
}
