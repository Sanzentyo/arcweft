pub style desktop_dialogue {
    .dialogue_panel {
        background = rgba(17, 18, 16, 242)
    }
    .dialogue_action {
        background = rgba(0, 0, 0, 0)
    }
    .desktop_dialogue {
        color = rgba(205, 239, 255, 255)
    }
}

pub style mobile_dialogue {
    .mobile_dialogue {
        color = rgba(248, 240, 255, 255)
    }
}

pub view DesktopDialogue(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px, part = dialogue_panel) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .style(@style.desktop_dialogue)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
}

pub view MobileDialogue(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px, part = dialogue_panel) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .style(@style.mobile_dialogue)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
}

pub dialogue defaults {
    view = @view.DesktopDialogue
    rich_text {
        text {
            font = "Yu Gothic"
            size = 30px
            color = rgb("#d9f2ff")
        }
        ruby {
            size = 14px
            gap = 2px
        }
    }
}

pub dialogue defaults @dialogue.mobile {
    view = @view.MobileDialogue
    rich_text {
        text {
            font = "Meiryo"
            size = 24px
            color = rgb("#f0f8ff")
        }
        ruby {
            size = 10px
            gap = 1px
        }
    }
}

pub character alice {
    display = "Alice"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                color = rgb("#8fd7ff")
            }
        }
    }
}

entry game {
    goto @flow.profiled_rich_text
}

flow profiled_rich_text {
    alice.say(id=@say.profiled.001, voice=auto)[
        Profile selected defaults decide ruby size and dialogue View style: |[星影](ほしかげ) と [.shake amp=1px seed=profiled]揺れる文字[/]。[p]
    ]

    return "profiled_rich_text"
}
