pub character lumi {
    display = "Lumi"
}

pub character iris {
    display = "Iris"
}

pub style animation_panel {
    .dialogue_panel {
        background-color = rgba(17, 18, 16, 242)
    }
    .dialogue_action {
        background-color = rgba(0, 0, 0, 0)
    }
    .animation_panel {
        color = rgba(242, 246, 255, 255)
    }
}

pub view AnimationPanel(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px, part = dialogue_panel) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .style(@style.animation_panel)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
}

#[fx]
fn breath_orbit(
    amplitude: Length = 5px,
    speed: f32 = 0.75,
) -> Fx {
    Fx.transform(
        target = .glyph,
        sample = |ctx| Transform2D {
            translate_y:
                sin(ctx.time * speed + ctx.ordinal_phase()) * amplitude,
        },
    )
}

#[fx]
fn source_drift(
    amplitude: Length = 5px,
    speed: f32 = 0.8,
) -> Fx {
    Fx.transform(
        target = .glyph,
        sample = |ctx| Transform2D {
            translate_x:
                sin(ctx.time * speed + ctx.ordinal_phase()) * amplitude,
        },
    )
}

entry cli @entry.rich_text_effects_animation {
    goto @flow.rich_text_effects_animation
}

flow rich_text_effects_animation {
    lumi(id=@say.effects.shader, voice=auto, look=.focus)[
        Shader: #fx(shader(resource=@.soft_glow, amount=0.65, direction=vec2(1.0, 0.0), phase=.offscreen_pass))[#color(rgb("#b9dcff"))[soft glow shader]]、#fx(shader(resource=@.warm_glow, amount=0.7, direction=vec2(-1.0, 0.0), phase=.offscreen_pass))[#color(rgb("#ffd8b0"))[warm glow shader]]、#fx(shader(resource=@.soft_glow, amount=1, phase=.glyph_color))[glyph color shader]、#fx(shader(resource=@.screen_tint, amount=0.55, color=rgb("#ff4050"), phase=.post_process))[post process shader] と、#fx(sparkle(amplitude=1.5px))[sparkle]、#fx(sparkle(phase=.glyph_color))[色sparkle] を同時に表示する。[p]
    ]

    lumi(id=@say.effects.post, voice=auto, look=.focus)[
        PostFX: #fx(wave(phase=.post_process, amplitude=8px, period=64px, direction=vec2(1.0, 0.0)))[post wave effect]、#fx(source_drift(amplitude=5px, speed=0.8))[source Fx transform]、post sparkle。[p]
    ]

    iris(id=@say.effects.motion, voice=auto, look=.bright)[
        Motion: #fx(wave(amplitude=4px, direction=vec2(0.0, 1.0), period=8, speed=1.6, target=.glyph, phase=.glyph_transform))[ゆらゆら波]、#fx(shake(amplitude=2px, target=.glyph, phase=.glyph_transform))[文字が揺れる]、#fx(jitter(amplitude=1.5px, target=.glyph, phase=.glyph_transform))[jitter]、#fx(sparkle(amplitude=2px))[sparkle]。[r]Fx関数: #fx(breath_orbit(amplitude=5px, speed=0.75))[関数motion]、#fx(source_drift(amplitude=5px, speed=0.8))[関数transform]。Event: host cue。[p]
    ]

    lumi(id=@say.effects.reveal, voice=auto, look=.smile)[
        Reveal: #fx(typewriter(characters_per_second=5, delay=500ms, cursor=true, cursor_alpha=0.4, phase=.glyph_mask))[遅れて一文字ずつ見えるtypewriter] と #fx(typewriter(characters_per_second=4, phase=.glyph_mask))[#fx(wave(amplitude=3px, direction=vec2(0.0, 1.0), speed=1.2, target=.glyph, phase=.glyph_transform))[#fx(shake(amplitude=1px, target=.glyph, phase=.glyph_transform))[#fx(sparkle(amplitude=1.5px))[重ね掛けtypewriter]]]]。[r]さらに #fx(spin(rotation_amplitude=8deg, speed=0.8, target=.glyph))[#fx(pulse(scale_amplitude=0.16, speed=1.15, target=.glyph))[回転して膨らむ文字]]。縦も #layout(.vertical_rl, jlreq=.strict)[#font("Yu Mincho")[#fx(spin(rotation_amplitude=8deg, speed=0.8, target=.glyph))[#fx(pulse(scale_amplitude=0.12, speed=1.1, target=.glyph))[縦回転]]]ABC2026]。[p]
    ]

    return "rich_text_effects_animation"
}
