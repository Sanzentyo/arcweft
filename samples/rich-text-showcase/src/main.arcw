pub character alice {
    display = "Alice"
}

pub character narrator {
    display = "Narrator"
}

pub character benio {
    display = "Benio"
}

pub character clerk {
    display = "Clerk"
}

pub style rich_text_panel {
    .dialogue_panel {
        background-color = rgba(17, 18, 16, 242)
    }
    .dialogue_action {
        background-color = rgba(0, 0, 0, 0)
    }
    .rich_text_panel {
        color = rgba(205, 239, 255, 255)
    }
}

pub view RichTextPanel(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px, part = dialogue_panel) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .style(@style.rich_text_panel)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
}

struct GameState {
    started: bool
}

enum GameEvent {
    Start
}

fn initial_game_state() -> GameState
effects {}
{
    GameState { started = false }
}

fn reduce_game(state: &GameState, event: GameEvent)
    -> Result<Reduction<GameState>, ReducerError>
effects {}
{
    Ok(Reduction.unchanged(state))
}

entry game @entry.main {
    state = GameState
    initializer = initial_game_state
    event = GameEvent
    reducer = reduce_game
    goto @flow.rich_text_showcase
}

flow rich_text_showcase(state: GameState) -> String {
    let alice_panel = alice(style=text_style(color=rgb("#9fdcff")))

    alice_panel(id=@say.rich_text.001, voice=auto, look=.smile, style=text_style(color=rgb("#8fd7ff")), rich_text=rich_text_style(ruby=ruby_style(size=11px, gap=1px)))[
        #font("Yu Gothic")[#color(rgb("#8fd7ff"))[光る]]#fx(wave(amplitude=3px, direction=vec2(0.0, 1.0), period=8, speed=1))[波]と、#fx(shake(amplitude=1px, seed=3u32))[震える声]。#transform(.offset, x=12px, y=-4px)[|[星屑](ほしくず)]が浮いて、#layout(.vertical_rl)[#font("Yu Mincho")[縦書きも混ざる]]。[p]
    ]

    narrator(id=@say.rich_text.002, voice=auto)[
        #font("Segoe UI")[Segoe UI] と #font("Consolas")[Consolas 123]、#font("MS Mincho")[明朝]、#font("Meiryo")[メイリオ] を同じ行で確認する。[p]
    ]

    benio(id=@say.rich_text.003, voice=auto, look=.confident)[
        #strong()[太字]、#em()[強調]、#style(.italic)[italic]、#style(.oblique, angle=12deg)[斜体角度]、#size(36pt)[大きな文字]、#color(rgb("#ff9ac8"))[色指定]。[p]
    ]

    clerk(id=@say.rich_text.004, voice=auto)[
        #layout(.vertical_rl)[#font("MS Mincho")[縦書き専用行。春夏秋冬、天地左右、和文の詰まりを見る。]] #font("MS Gothic")[横組み MS Gothic で比較]。[p]
    ]

    narrator(id=@say.rich_text.005, voice=auto)[
        #fx(jitter(amplitude=1px))[静かな揺らぎ]、#fx(arc(radius=24px, start_angle=-20deg, step_angle=10deg))[円弧配置]、#fx(shader(resource=@.soft_glow, amount=0.6, direction=vec2(1.0, 0.0)))[shader参照]、#fx(typewriter(characters_per_second=18))[typewriter] を保持する。[p]
    ]

    alice(id=@say.rich_text.006, voice=auto)[
        [mark @.keyword]明示的な marker を置き、[reset]#font("Yu Gothic")[reset 後の通常文字]へ戻す。[p]
    ]

    return "rich_text_showcase"
}
