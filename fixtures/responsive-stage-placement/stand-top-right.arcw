pub image @image.zundamon.stand.responsive {
    asset = @asset:.zundamon.normal
    layer = @layer.character
    target = @target.zundamon.stand
    position = anchor(top_right)
    object_anchor = top_right
    margin.top = 20px
    margin.right = 100px
    size.width = 250px
    size.height = 430px
    scale = design
    fit = "contain"
    alignment.x = "center"
    alignment.y = "bottom"
}

entry cli @entry.stand_top_right {
    goto @flow.main
}

flow main {
    image(@image.zundamon.stand.responsive)
}
