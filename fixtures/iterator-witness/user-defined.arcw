struct Counter {
    start: i64,
    end: i64,
}

struct CounterIter {
    current: i64,
    end: i64,
}

impl IntoIterator for Counter {
    type Item = i64
    type IntoIter = CounterIter

    fn into_iter(self) -> CounterIter {
        CounterIter { current: self.start, end: self.end }
    }
}

impl Iterator for CounterIter {
    type Item = i64

    fn next(&mut self) -> Option<i64> {
        if self.current < self.end {
            let value = self.current
            self.current = self.current + 1
            Some(value)
        } else {
            None
        }
    }
}

struct Collector {
    last: i64,
}

flow counter_demo() -> i64 {
    let collector = Collector { last: -1 }
    for value in (Counter { start: 0, end: 3 }) {
        collector.last = value
    }
    return collector.last
}
