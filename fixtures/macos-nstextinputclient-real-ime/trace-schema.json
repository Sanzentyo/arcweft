{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arcweft macOS NSTextInputClient IME trace event",
  "type": "object",
  "required": ["phase"],
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "swift_event",
        "arcweft_event",
        "editor_state",
        "geometry_state",
        "secure_audit",
        "validation_note"
      ]
    },
    "event": { "type": "string" },
    "selector": { "type": "string" },
    "text": { "type": "string" },
    "preedit": { "type": "string" },
    "commit": { "type": "string" },
    "range": {
      "type": "object",
      "properties": {
        "location": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 }
      },
      "required": ["location", "length"],
      "additionalProperties": false
    },
    "rect": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      },
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false
    },
    "serial": { "type": "integer", "minimum": 0 },
    "generation": { "type": "integer", "minimum": 0 },
    "secure": { "type": "boolean" },
    "note": { "type": "string" }
  },
  "additionalProperties": true
}
