pub surface character @character.audit Audit as audit {
    default_voice = auto
    dialogue_style {
        font = "MS Mincho"
        text_color = "#f4f4ff"
        text_size = 30
    }
}

entry game {
    goto @flow.vertical_goal_clear_smoke
}

flow @flow.vertical_goal_clear_smoke vertical_goal_clear_smoke {
    audit.say(id=@say.vertical_goal_clear_smoke.001, voice=auto)[
        [.vertical_rl jlreq=strict][font "MS Mincho"]吾|[輩](はい)は2026ABC。[/font][/][br]
        [.vertical_lr jlreq=strict][font "MS Mincho"]縦|[夢](ゆめ)へ[.typewriter cps=1]2026[/]XYZ。[/font][/][p]
    ]

    return "vertical_goal_clear_smoke"
}
