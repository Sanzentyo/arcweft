pub character alice {
    display = "Alice"
}

entry cli @entry.vertical_tutr_golden {
    goto @flow.vertical_tutr_golden
}

flow vertical_tutr_golden() -> String {
    alice(id=@say.vertical_tutr_golden.001, voice=auto)[
        #layout(.vertical_rl)[#font("MS Mincho")[吾輩は猫である。ABC 123 2026。ー「縦書き」]][p]
    ]

    return "vertical_tutr_golden"
}
