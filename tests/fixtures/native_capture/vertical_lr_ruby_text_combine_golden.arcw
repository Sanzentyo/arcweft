pub character @character.alice Alice as alice {
    default_voice = auto
    dialogue_style {
        font = "MS Mincho"
        text_color = "#d9f2ff"
        text_size = 30
    }
}

entry game {
    goto @flow.vertical_lr_ruby_text_combine_golden
}

flow @flow.vertical_lr_ruby_text_combine_golden vertical_lr_ruby_text_combine_golden {
    alice.say(id=@say.vertical_lr_ruby_text_combine_golden.001, voice=auto)[
        [.vertical_lr][font "MS Mincho"]縦 |[夢](ゆめ)[r] 2026 ABC。[/font][/][p]
    ]

    return "vertical_lr_ruby_text_combine_golden"
}
