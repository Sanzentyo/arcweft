pub character alice {
    display = "Alice"
}

entry cli @entry.vertical_lr_ruby_text_combine_golden {
    goto @flow.vertical_lr_ruby_text_combine_golden
}

flow vertical_lr_ruby_text_combine_golden() -> String {
    alice(id=@say.vertical_lr_ruby_text_combine_golden.001, voice=auto)[
        #layout(.vertical_lr)[#font("MS Mincho")[縦 |[夢](ゆめ)[r] 2026 ABC。]][p]
    ]

    return "vertical_lr_ruby_text_combine_golden"
}
