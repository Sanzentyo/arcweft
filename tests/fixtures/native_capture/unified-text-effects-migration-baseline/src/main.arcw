pub character lumi {
    display = "Lumi"
}

pub style migration_effects_panel {
    .dialogue_panel {
        background-color = rgba(17, 18, 16, 242)
    }
    .dialogue_action {
        background-color = rgba(0, 0, 0, 0)
    }
    .migration_effects_panel {
        color = rgba(242, 246, 255, 255)
    }
}

pub view MigrationEffectsPanel(dialogue: DialogueView) {
    Panel(x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px, part = dialogue_panel) {
        Text(dialogue.speaker)
            .x(85.6px)
            .y(480.8px)
            .width(1108.8px)
            .height(28px)
        RichText(dialogue.content)
            .x(85.6px)
            .y(518.8px)
            .width(1108.8px)
            .height(125.6px)
            .style(@style.migration_effects_panel)
        Button("", x = 57.6px, y = 460.8px, width = 1164.8px, height = 201.6px)
            .part(dialogue_action)
            .on_click { dialogue.primary_action }
    }
}

#[fx]
fn breath_orbit(
    amplitude: Length = 5px,
    speed: f32 = 0.75,
) -> Fx {
    Fx.transform(
        target = .glyph,
        sample = |ctx| Transform2D {
            translate_y:
                sin(ctx.time * speed + ctx.ordinal_phase()) * amplitude,
        },
    )
}

#[fx]
fn source_drift(
    amplitude: Length = 5px,
    speed: f32 = 0.8,
) -> Fx {
    Fx.transform(
        target = .glyph,
        sample = |ctx| Transform2D {
            translate_x:
                sin(ctx.time * speed + ctx.ordinal_phase()) * amplitude,
        },
    )
}

entry cli @entry.unified_text_effects_migration_baseline {
    goto @flow.unified_text_effects_migration_baseline
}

flow unified_text_effects_migration_baseline {
    lumi(id=@say.migration.matrix, voice=auto, look=.focus)[
        FX: #fx(shader(resource=@.soft_glow, amount=0.65, direction=vec2(1.0, 0.0), phase=.offscreen_pass))[#color(rgb("#b9dcff"))[glow]] #fx(shader(resource=@.warm_glow, amount=0.7, direction=vec2(-1.0, 0.0), phase=.offscreen_pass))[#color(rgb("#ffd8b0"))[warm]] #fx(shader(resource=@.soft_glow, amount=1, phase=.glyph_color))[color] #fx(shader(resource=@.screen_tint, amount=0.55, color=rgb("#ff4050"), phase=.post_process))[post] sparkle。[r]
        Motion: #fx(wave(amplitude=4px, direction=vec2(0.0, 1.0), period=8, speed=1.6, target=.glyph, phase=.glyph_transform))[wave] #fx(shake(amplitude=2px, target=.glyph, phase=.glyph_transform))[shake] #fx(jitter(amplitude=1.5px, target=.glyph, phase=.glyph_transform))[jitter] #fx(breath_orbit(amplitude=5px, speed=0.75))[source-y] #fx(source_drift(amplitude=5px, speed=0.8))[source-x]。[r]
        Reveal: #fx(typewriter(characters_per_second=4, delay=500ms, cursor=true, cursor_alpha=0.4, phase=.glyph_mask))[#fx(wave(amplitude=3px, direction=vec2(0.0, 1.0), speed=1.2, target=.glyph, phase=.glyph_transform))[#fx(shake(amplitude=1px, target=.glyph, phase=.glyph_transform))[#fx(sparkle(amplitude=1.5px))[typewriter-wave-shake]]]] #fx(spin(rotation_amplitude=8deg, speed=0.8, target=.glyph))[#fx(pulse(scale_amplitude=0.16, speed=1.15, target=.glyph))[spin-pulse]]。[r]
        Vertical: #layout(.vertical_rl, jlreq=.strict)[#font("Yu Mincho")[#fx(spin(rotation_amplitude=8deg, speed=0.8, target=.glyph))[#fx(pulse(scale_amplitude=0.12, speed=1.1, target=.glyph))[縦回転]]ABC2026]]。[p]
    ]

    return "unified_text_effects_migration_baseline"
}
