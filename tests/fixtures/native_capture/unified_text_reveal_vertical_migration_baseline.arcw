pub character lumi {
    display = "Lumi"
}

entry cli @entry.unified_text_reveal_vertical_migration_baseline {
    goto @flow.unified_text_reveal_vertical_migration_baseline
}

flow unified_text_reveal_vertical_migration_baseline {
    lumi(id=@say.migration.reveal_vertical, voice=auto, look=.focus)[
        Reveal: #fx(typewriter(characters_per_second=4, delay=500ms, cursor=true, cursor_alpha=0.4, phase=.glyph_mask))[#fx(wave(amplitude=3px, direction=vec2(0.0, 1.0), speed=1.2, target=.glyph, phase=.glyph_transform))[#fx(shake(amplitude=1px, target=.glyph, phase=.glyph_transform))[#fx(sparkle(amplitude=1.5px))[typewriter-wave-shake]]]] #fx(spin(rotation_amplitude=8deg, speed=0.8, target=.glyph))[#fx(pulse(scale_amplitude=0.16, speed=1.15, target=.glyph))[spin-pulse]]。[r]
        Vertical: #layout(.vertical_rl, jlreq=.strict)[#font("Yu Mincho")[#fx(typewriter(characters_per_second=3, phase=.glyph_mask))[#fx(spin(rotation_amplitude=8deg, speed=0.8, target=.glyph))[#fx(pulse(scale_amplitude=0.12, speed=1.1, target=.glyph))[縦回転]]]ABC2026]]。[p]
    ]

    return "unified_text_reveal_vertical_migration_baseline"
}
