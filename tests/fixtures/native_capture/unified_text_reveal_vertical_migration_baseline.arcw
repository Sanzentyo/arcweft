pub character lumi {
    display = "Lumi"
    default_voice = auto
    dialogue_style {
        rich_text {
            text {
                font = "Yu Gothic"
                color = rgb("#eaf6ff")
                size = 30px
            }
        }
    }
}

entry game {
    goto @flow.unified_text_reveal_vertical_migration_baseline
}

flow unified_text_reveal_vertical_migration_baseline {
    lumi.say(id=@say.migration.reveal_vertical, voice=auto, look=.focus)[
        Reveal: [.typewriter cps=4 delay=500ms cursor=true cursor_alpha=0.4 phase=glyph_mask][.wave amp=3px dir=0,1 speed=1.2 target=glyph phase=glyph_transform][.shake amp=1px seed=combo state_scope=glyph target=glyph phase=glyph_transform][.sparkle amp=1.5px seed=combo state_scope=run]typewriter-wave-shake[/][/][/][/] [.spin angle=8deg speed=0.8 origin=glyph_center target=glyph][.pulse amp=0.16 speed=1.15 origin=glyph_center target=glyph]spin-pulse[/][/]。[r]
        Vertical: [.vertical_rl jlreq=strict][font "Yu Mincho"][.typewriter cps=3 phase=glyph_mask][.spin angle=8deg speed=0.8 origin=glyph_center target=glyph][.pulse amp=0.12 speed=1.1 origin=glyph_center target=glyph]縦回転[/][/][/]ABC2026[/font][/]。[p]
    ]

    return "unified_text_reveal_vertical_migration_baseline"
}
