pub character alice {
    display = "Alice"
}

entry cli @entry.vertical_jlreq_preset_loose_golden {
    goto @flow.vertical_jlreq_preset_loose_golden
}

flow vertical_jlreq_preset_loose_golden() -> String {
    alice(id=@say.vertical_jlreq_preset_loose_golden.001, voice=auto)[
        #layout(.vertical_rl, jlreq=.loose)[#font("MS Mincho")[天地。」人山川海。『火水木]][p]
    ]

    return "vertical_jlreq_preset_loose_golden"
}
