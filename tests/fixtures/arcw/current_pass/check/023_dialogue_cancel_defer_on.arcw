character @character.alice Alice as alice {
}

flow @flow.cancel_edge cancel_edge {
    alice(voice=auto):
        長い台詞です。[p]
    with:
        defer on completed:
            log.info("completed")
        defer on cancelled:
            log.info("cancelled")
        cancel on input(.SkipLine) {
            out .Skipped
        }
    return "done"
}
