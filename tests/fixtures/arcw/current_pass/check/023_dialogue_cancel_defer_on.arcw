character alice {
    display_name = "Alice"
}

flow cancel_edge() -> String {
    alice(voice=auto):
        長い台詞です。[p]
    with:
        defer on completed:
            log.info("completed")
        defer on cancelled:
            log.info("cancelled")
        cancel on input(.SkipLine) {
            out .Skipped
        }
    return "done"
}
