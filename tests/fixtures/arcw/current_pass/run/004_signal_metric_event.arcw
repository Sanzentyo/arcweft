entry cli @entry.main { goto @flow.main }

signal @signal.ready ready: Watch<bool>
metric gauge @metric.count count: i32 {}

flow main() -> String effects { signal.write, metric.write } {
    signal.set(@signal.ready, true)
    metric.set(@metric.count, 1i32)
    event.emit("AppStarted", flow = @flow.main)
    return "done"
}
