extern capability fs {
    type FsError
    fn write_text(path: VirtualPath, body: String) -> Need<Result<Unit, FsError>> effects { fs.write }
}
extern capability path {
    fn save(path: String) -> VirtualPath
}
entry cli @entry.main {
    goto @flow.main
}
flow main() -> String effects { fs.write(save) } {
    let status = match (await fs.write_text(path.save("profile.json"), "{}")) {
        .Ok(_) => "ok"
        .Err(_) => "failed"
    }
    return status
}
