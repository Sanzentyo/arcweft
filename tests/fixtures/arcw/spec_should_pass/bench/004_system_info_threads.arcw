extern capability system {
    type SystemError
    fn core_count() -> Need<Result<String, SystemError>> effects { system.read }
    fn thread_count() -> Need<Result<String, SystemError>> effects { system.read }
    fn available_parallelism() -> Need<Result<String, SystemError>> effects { system.read }
}

bench @bench.system_threads {
    measure iterations = 1 { goto @flow.system_threads }
}

flow system_threads effects { system.read, control.spawn } {
    thread cores {
        let value = match (await system.core_count()) { .Ok(value) => value, .Err(_) => "core_failed" }
        log.info(value)
    }
    thread threads {
        let value = match (await system.thread_count()) { .Ok(value) => value, .Err(_) => "thread_failed" }
        log.info(value)
    }
    thread available {
        let value = match (await system.available_parallelism()) { .Ok(value) => value, .Err(_) => "available_failed" }
        log.info(value)
    }
    return "done"
}
