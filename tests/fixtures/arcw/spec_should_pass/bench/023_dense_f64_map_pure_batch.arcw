entry bench @entry.dense_f64_map_pure_batch { goto @flow.dense_f64_map_pure_batch }

#[pure]
fn score_f64(base: f64, scale: f64) -> f64 {
    return base * (scale + 2.0f64)
}

bench @bench.dense_f64_map_pure_batch {
    measure iterations = 4 { goto @flow.dense_f64_map_pure_batch }
}

flow dense_f64_map_pure_batch() -> String {
    let values: Array<f64, 128> = [2.0f64; 128]
    let scores: Array<f64, 128> = values.map(|item| score_f64(item, 2.0f64))
    log.info(scores.len())
    return "done"
}
