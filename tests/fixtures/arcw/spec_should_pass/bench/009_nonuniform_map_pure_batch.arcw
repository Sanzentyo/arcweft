#[pure]
fn score(base: i64, bonus: i64) -> i64 {
    return base * (bonus + 2i64)
}

bench @bench.nonuniform_map_pure_batch {
    measure iterations = 4 { goto @flow.nonuniform_map_pure_batch }
}

flow @flow.nonuniform_map_pure_batch nonuniform_map_pure_batch {
    let values: Vec<i64> = [1i64, 2i64, 3i64, 4i64, 5i64, 6i64, 7i64, 8i64, 9i64, 10i64, 11i64, 12i64, 13i64, 14i64, 15i64, 16i64, 17i64, 18i64, 19i64, 20i64, 21i64, 22i64, 23i64, 24i64, 25i64, 26i64, 27i64, 28i64, 29i64, 30i64, 31i64, 32i64, 33i64, 34i64, 35i64, 36i64, 37i64, 38i64, 39i64, 40i64, 41i64, 42i64, 43i64, 44i64, 45i64, 46i64, 47i64, 48i64, 49i64, 50i64, 51i64, 52i64, 53i64, 54i64, 55i64, 56i64, 57i64, 58i64, 59i64, 60i64, 61i64, 62i64, 63i64, 64i64, 65i64, 66i64, 67i64, 68i64, 69i64, 70i64, 71i64, 72i64, 73i64, 74i64, 75i64, 76i64, 77i64, 78i64, 79i64, 80i64, 81i64, 82i64, 83i64, 84i64, 85i64, 86i64, 87i64, 88i64, 89i64, 90i64, 91i64, 92i64, 93i64, 94i64, 95i64, 96i64, 97i64, 98i64, 99i64, 100i64, 101i64, 102i64, 103i64, 104i64, 105i64, 106i64, 107i64, 108i64, 109i64, 110i64, 111i64, 112i64, 113i64, 114i64, 115i64, 116i64, 117i64, 118i64, 119i64, 120i64, 121i64, 122i64, 123i64, 124i64, 125i64, 126i64, 127i64, 128i64]
    let scores: Vec<i64> = values.map(|item| score(item, 2i64))
    let total: i64 = scores.sum()
    log.info(total)
    return "done"
}
