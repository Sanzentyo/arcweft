entry bench @entry.matrix_matmul_f32 { goto @flow.matrix_matmul_f32 }

bench @bench.matrix_matmul_f32 {
    measure iterations = 4 { goto @flow.matrix_matmul_f32 }
}

flow matrix_matmul_f32(lhs: MatrixF32, rhs: MatrixF32) -> MatrixF32 {
    let product = math.matmul_f32(lhs, rhs)
    return product
}
