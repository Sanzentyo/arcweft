#[pure]
fn score_u8(base: u8, bonus: u8) -> u8 {
    return base * (bonus + 2u8)
}

bench @bench.dense_u8_map_pure_batch {
    measure iterations = 4 { start(@flow.dense_u8_map_pure_batch) }
}

flow @flow.dense_u8_map_pure_batch dense_u8_map_pure_batch {
    let values: Vec<u8> = [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8]
    let scores: Vec<u8> = values.map(|item| score_u8(item, 2u8))
    let total: i64 = scores.sum()
    log.info(total)
    return "done"
}
