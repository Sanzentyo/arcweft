#[pure]
fn score_u128(base: u128, bonus: u128) -> u128 {
    return base * (bonus + 2u128)
}

bench @bench.dense_u128_map_pure_batch {
    measure iterations = 4 { goto @flow.dense_u128_map_pure_batch }
}

flow @flow.dense_u128_map_pure_batch dense_u128_map_pure_batch {
    let values: Vec<u128> = [1u128, 2u128, 3u128, 4u128, 5u128, 6u128, 7u128, 8u128, 9u128, 10u128, 11u128, 12u128, 13u128, 14u128, 15u128, 16u128, 17u128, 18u128, 19u128, 20u128, 21u128, 22u128, 23u128, 24u128, 25u128, 26u128, 27u128, 28u128, 29u128, 30u128, 31u128, 32u128, 33u128, 34u128, 35u128, 36u128, 37u128, 38u128, 39u128, 40u128, 41u128, 42u128, 43u128, 44u128, 45u128, 46u128, 47u128, 48u128, 49u128, 50u128, 51u128, 52u128, 53u128, 54u128, 55u128, 56u128, 57u128, 58u128, 59u128, 60u128, 61u128, 62u128, 63u128, 64u128, 65u128, 66u128, 67u128, 68u128, 69u128, 70u128, 71u128, 72u128, 73u128, 74u128, 75u128, 76u128, 77u128, 78u128, 79u128, 80u128, 81u128, 82u128, 83u128, 84u128, 85u128, 86u128, 87u128, 88u128, 89u128, 90u128, 91u128, 92u128, 93u128, 94u128, 95u128, 96u128, 97u128, 98u128, 99u128, 100u128, 101u128, 102u128, 103u128, 104u128, 105u128, 106u128, 107u128, 108u128, 109u128, 110u128, 111u128, 112u128, 113u128, 114u128, 115u128, 116u128, 117u128, 118u128, 119u128, 120u128, 121u128, 122u128, 123u128, 124u128, 125u128, 126u128, 127u128, 128u128]
    let scores: Vec<u128> = values.map(|item| score_u128(item, 2u128))
    let total: i64 = scores.sum()
    log.info(total)
    return "done"
}
