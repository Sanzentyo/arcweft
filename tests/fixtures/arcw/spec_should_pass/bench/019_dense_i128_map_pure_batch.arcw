#[pure]
fn score_i128(base: i128, bonus: i128) -> i128 {
    return base * (bonus + 2i128)
}

bench @bench.dense_i128_map_pure_batch {
    measure iterations = 4 { start(@flow.dense_i128_map_pure_batch) }
}

flow @flow.dense_i128_map_pure_batch dense_i128_map_pure_batch {
    let values: Vec<i128> = [1i128, 2i128, 3i128, 4i128, 5i128, 6i128, 7i128, 8i128, 9i128, 10i128, 11i128, 12i128, 13i128, 14i128, 15i128, 16i128, 17i128, 18i128, 19i128, 20i128, 21i128, 22i128, 23i128, 24i128, 25i128, 26i128, 27i128, 28i128, 29i128, 30i128, 31i128, 32i128, 33i128, 34i128, 35i128, 36i128, 37i128, 38i128, 39i128, 40i128, 41i128, 42i128, 43i128, 44i128, 45i128, 46i128, 47i128, 48i128, 49i128, 50i128, 51i128, 52i128, 53i128, 54i128, 55i128, 56i128, 57i128, 58i128, 59i128, 60i128, 61i128, 62i128, 63i128, 64i128, 65i128, 66i128, 67i128, 68i128, 69i128, 70i128, 71i128, 72i128, 73i128, 74i128, 75i128, 76i128, 77i128, 78i128, 79i128, 80i128, 81i128, 82i128, 83i128, 84i128, 85i128, 86i128, 87i128, 88i128, 89i128, 90i128, 91i128, 92i128, 93i128, 94i128, 95i128, 96i128, 97i128, 98i128, 99i128, 100i128, 101i128, 102i128, 103i128, 104i128, 105i128, 106i128, 107i128, 108i128, 109i128, 110i128, 111i128, 112i128, 113i128, 114i128, 115i128, 116i128, 117i128, 118i128, 119i128, 120i128, 121i128, 122i128, 123i128, 124i128, 125i128, 126i128, 127i128, 128i128]
    let scores: Vec<i128> = values.map(|item| score_i128(item, 2i128))
    let total: i64 = scores.sum()
    log.info(total)
    return "done"
}
