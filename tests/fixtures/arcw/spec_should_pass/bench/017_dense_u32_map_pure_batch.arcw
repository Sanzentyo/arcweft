#[pure]
fn score_u32(base: u32, bonus: u32) -> u32 {
    return base * (bonus + 2u32)
}

bench @bench.dense_u32_map_pure_batch {
    measure iterations = 4 { goto @flow.dense_u32_map_pure_batch }
}

flow dense_u32_map_pure_batch {
    let values: Vec<u32> = [1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 7u32, 8u32, 9u32, 10u32, 11u32, 12u32, 13u32, 14u32, 15u32, 16u32, 17u32, 18u32, 19u32, 20u32, 21u32, 22u32, 23u32, 24u32, 25u32, 26u32, 27u32, 28u32, 29u32, 30u32, 31u32, 32u32, 33u32, 34u32, 35u32, 36u32, 37u32, 38u32, 39u32, 40u32, 41u32, 42u32, 43u32, 44u32, 45u32, 46u32, 47u32, 48u32, 49u32, 50u32, 51u32, 52u32, 53u32, 54u32, 55u32, 56u32, 57u32, 58u32, 59u32, 60u32, 61u32, 62u32, 63u32, 64u32, 65u32, 66u32, 67u32, 68u32, 69u32, 70u32, 71u32, 72u32, 73u32, 74u32, 75u32, 76u32, 77u32, 78u32, 79u32, 80u32, 81u32, 82u32, 83u32, 84u32, 85u32, 86u32, 87u32, 88u32, 89u32, 90u32, 91u32, 92u32, 93u32, 94u32, 95u32, 96u32, 97u32, 98u32, 99u32, 100u32, 101u32, 102u32, 103u32, 104u32, 105u32, 106u32, 107u32, 108u32, 109u32, 110u32, 111u32, 112u32, 113u32, 114u32, 115u32, 116u32, 117u32, 118u32, 119u32, 120u32, 121u32, 122u32, 123u32, 124u32, 125u32, 126u32, 127u32, 128u32]
    let scores: Vec<u32> = values.map(|item| score_u32(item, 2u32))
    let total: i64 = scores.sum()
    log.info(total)
    return "done"
}
