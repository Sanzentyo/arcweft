entry bench @entry.matrix_matmul_f64 { goto @flow.matrix_matmul_f64 }

bench @bench.matrix_matmul_f64 {
    measure iterations = 4 { goto @flow.matrix_matmul_f64 }
}

flow matrix_matmul_f64(lhs: MatrixF64, rhs: MatrixF64) -> MatrixF64 {
    let product = math.matmul_f64(lhs, rhs)
    return product
}
