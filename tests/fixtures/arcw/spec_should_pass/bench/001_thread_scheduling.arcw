entry bench @entry.threads { goto @flow.threads }

bench @bench.threads {
    measure iterations = 1 { goto @flow.threads }
}

flow threads() -> String {
    thread first {
        log.info("first")
    }
    thread second {
        log.info("second")
    }
    thread third {
        log.info("third")
    }
    return "done"
}
