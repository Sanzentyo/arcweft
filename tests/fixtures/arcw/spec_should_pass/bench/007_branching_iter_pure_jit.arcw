#[pure]
fn branch_score(item: i64, bias: i64) -> i64 {
    return if item >= 8i64 { item * bias } else { (item + bias) * 2i64 }
}

bench @bench.branching_iter_pure {
    measure iterations = 6 { start(@flow.branching_iter_pure) }
}

flow @flow.branching_iter_pure branching_iter_pure {
    let values: Vec<i64> = [1i64, 2i64, 3i64, 4i64, 5i64, 6i64, 7i64, 8i64, 9i64, 10i64, 11i64, 12i64, 13i64, 14i64, 15i64, 16i64]
    let scores: Vec<i64> = values.map(|item| branch_score(item, 3i64))
    let total: i64 = scores.sum()
    for item in values {
        let adjusted = branch_score(item, 2i64)
        if adjusted >= 20i64 {
            log.info(adjusted)
        } else {
            log.info(item)
        }
    }
    log.info(total)
    return "done"
}
