extern capability fs {
    type FsError
    fn read_text(path: VirtualPath) -> Need<Result<String, FsError>> effects { fs.read }
}
extern capability path { fn save(path: String) -> VirtualPath }

entry cli @entry.main { goto @flow.main }

flow main() -> String effects { fs.read(save) } {
    let profile = match (await fs.read_text(path.save("profile.json"))) {
        .Ok(profile) => profile
        .Err(_) => "{}"
    }
    return profile
}
