extern capability path {
    fn asset(path: String) -> VirtualPath
}
extern capability fs {
    type FsError
    fn read_text(path: VirtualPath) -> Need<String, FsError> effects { fs.read }
}

flow @flow.main main effects { fs.read(asset) } {
    let text = try await fs.read_text(path.asset("dialogue/opening.txt")) with {
        error e => return "missing"
    }
    return text
}
