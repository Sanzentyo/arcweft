type ArcResult<T> = Result<T, ArcError>

flow @flow.await_context await_context() -> ArcResult<String>
effects { log.write }
{
    let bg = try await asset.image(@asset:.bg.room)
        .context("opening background failed")
    with:
        pending p:
            log.info("loading bg", progress = p.ratio)

    let fg = (await asset.image(@asset:.bg.fg) with:
        pending p:
            log.info("loading fg", progress = p.ratio)
    )?

    let voice = await? voice.load(@voice.alice.001) with:
        pending p:
            log.info("loading voice", progress = p.ratio)

    let route = state.route_override
        .context("route override is missing")

    return Ok("done")
}
