type ArcResult<T> = Result<T, ArcError>

struct AwaitContextState {
    route_override: Option<Ref<Flow>>
}

flow await_context(
    background: Ref<Asset>,
    foreground: Ref<Asset>,
    voice_asset: Ref<Voice>,
    state: AwaitContextState,
) -> ArcResult<String>
effects { log.write }
{
    let bg = try (await asset.image(background) with:
        pending p:
            log.info("loading bg", progress = p.ratio)
    ).context("opening background failed")

    let fg = try (await asset.image(foreground) with:
        pending p:
            log.info("loading fg", progress = p.ratio)
    ).context("opening foreground failed")

    let voice = try (await voice.load(voice_asset) with:
        pending p:
            log.info("loading voice", progress = p.ratio)
    ).context("voice load failed")

    let route = state.route_override.context("route override is missing")

    return Ok("done")
}
