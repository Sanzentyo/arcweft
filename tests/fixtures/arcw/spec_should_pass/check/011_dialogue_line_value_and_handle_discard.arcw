entry cli @entry.main { goto @flow.line_handles }

pub character alice {
    display = "Alice"
}

flow line_handles() -> String {
    let (_, cue) = alice(voice=auto)[聞いて。[p]]
    with:
        let cue = "cue kept"
        let voice = line.voice_handle()
        out (voice, cue)

    log.info("cue kept", cue = cue)
    return "done"
}
