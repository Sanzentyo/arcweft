pub character alice { display = "Alice" }

flow dialogue_edge() -> String {
    alice(voice=auto):
        今日は少しだけ、｜変な夢《へんなゆめ》を見たんだ。[p]
    with:
        let actor = alice.stage.acquire(scope=line)
        at(0.42s): actor.look(.worried)
        defer on cancelled:
            log.info("cancelled")
        cancel on input(.SkipLine) {
            out "Skipped"
        }
        out "Done"
    return "done"
}
